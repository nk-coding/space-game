// Evolve a behavior for the starter ship (the rim skiff) against two and three raiders and a hunter; the design
// stays as it is.
// `cargo run --release -p arena-cli -- evolve crates/core/arena/runs/skiff_behavior.ron --out /tmp/skiff_behavior`
// The archive spreads behaviors by how far from the enemy they fight and how many rules they run (`docs/arena.md`
// "Evolution"). PLACEHOLDER numbers.
(
    seed: 1,
    evolve: Behavior,
    generations: 30,
    population: 32,
    trials: [(
        kind: EnemyShips(opponents: [
            (design: Ship("automaton_raider"), count: 2),
            (design: Ship("automaton_raider"), count: 3),
            (design: Ship("automaton_hunter")),
        ]),
        seeds: 4,
        time_limit: 60,
    )],
    starts: [Design(design: Ship("rim_skiff"), behavior: Content("skirmisher"))],
    archive: (
        axes: [
            (measure: EngageDistance, min: 0, max: 160, cells: 8),
            (measure: Rules, min: 0, max: 12, cells: 6),
        ],
    ),
)
