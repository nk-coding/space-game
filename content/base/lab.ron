// The evolution lab (GDR-0092): the goals a run weighs, the genes it may change, the trials it can fight and the
// stand-in pilots. What each goal, gene and trial kind computes is the arena's (`docs/arena.md` "Trials and goals",
// "Genomes, mutation and crossover"); the words and numbers are here. A run keeps its trials and pilot as they were
// when it was made, so a change here changes no run. Weights run 0 to 3; `seeds` is how many seeds each opponent is
// fought on (1, 2, ...); `time_limit` is seconds a fight lasts at most (minutes for VOYAGES). `default: true` trials
// are on in a new run (GDR-0092's default selection). `genes` are what a run may change (MAY CHANGE) and
// `gene_presets` the pills over them, the first a new run's. `pilots` are the stand-ins that fly a design in the
// fights a run has FLOWN BY a stand-in, so its pilot assists are scored (the first is the setup's default): each
// think it locks the nearest enemy (`lock`), holds the stick towards it while it is farther than `close_to` of its
// longest gun's reach, and holds every trigger, each on for `on` seconds then off for `off` (left out: never); what
// it leaves alone the assists may take. The ARMS RACE (`CoEvolution`) has an enemy population evolve against yours in
// the run: `size` its children as a share of yours, `elites` and `hall` how many of the other side's best and past
// champions each side fights, `anchor` that the enemy also fights your starts, every `check_every` generations the PAST
// CHAMPIONS check against the champions of every `champions_every`th generation, `mirror` symmetric enemies; its starts
// are an enemy faction's ships, and `palettes` add parts a faction may build with besides its ships'. PLACEHOLDER
// NUMBERS (lead defaults of 15 and 16 Oct 2026; the measured cost of each kind is in docs/arena.md). `kinds` are the
// words of the trial kinds the arena fights (a trial without a preset shows its kind's). `sizes` are SIZE's presets:
// children per generation and generations (`default: true` a new run's). `measures` are what the archive spreads
// designs by, named by a stat of stats.ron (`stat`) or by their own `name` and `unit`; `spreads` are its grids, `design`
// for runs whose design may change, `behavior` for the others: each axis `cells` bins of a measure from `min` to `max`
// (the design spread is the arena's own default, for CLI runs too). `budget` is how many ms a frame gives the run that
// computes: with the EVOLUTION layer open, and anywhere else at home and on the screens (in flight it pauses). The
// mutation operators' weights are the arena's (docs/arena.md "Genomes, mutation and crossover").
(
    goals: [
        (id: "win", name: "Win", summary: "Beat the opponent: a win counts 1, a loss 0, a draw by the build points each side lost.", weight: 1),
        (id: "unhurt", name: "Unhurt", summary: "Come out whole: one less the share of your own build points lost."),
        (id: "quick", name: "Quick", summary: "Win fast: one less the share of the time limit a win took; nothing for a fight not won."),
        (id: "cheap", name: "Cheap", summary: "Cost little: one less the design's build points over the run's build-point limit."),
    ],
    goal_presets: [
        (id: "win", name: "Win", weights: {"win": 1}),
        (id: "win_unhurt", name: "Win unhurt", weights: {"win": 1, "unhurt": 1}),
        (id: "win_cheaply", name: "Win cheaply", weights: {"win": 1, "cheap": 1}),
        (id: "win_fast", name: "Win fast", weights: {"win": 1, "quick": 1}),
    ],
    trials: [
        (
            id: "enemies_you_meet",
            name: "The enemies you meet",
            summary: "Every encounter of the voyages open to you, its ships at their largest count: what voyages throw at you. It grows with the career.",
            kind: Encounters,
            weight: 2,
            seeds: 4,
            time_limit: 60,
            default: true,
        ),
        (
            id: "test_range_waves",
            name: "Test-range waves",
            summary: "Waves as the test range sends them, sized to the design, one after the other until it is out or time is up; five cleared is a win. Fair for a design of any size.",
            kind: Waves(target: 5),
            seeds: 2,
            time_limit: 180,
            default: true,
        ),
        (
            id: "beat_your_start",
            name: "Beat your start",
            summary: "Every start of the run under its own behavior: is it better than what you had?",
            kind: BeatYourStart,
            seeds: 2,
            time_limit: 60,
            default: true,
        ),
        (
            id: "hall_of_fame",
            name: "Hall of fame",
            summary: "The run's own best designs so far: a bar that keeps rising, so scores don't stall.",
            kind: HallOfFame(count: 4),
            seeds: 2,
            time_limit: 60,
            default: true,
        ),
        (
            id: "enemy_ships",
            name: "Enemy ships",
            summary: "Enemy ships of your choosing, each pack a fight.",
            kind: EnemyShips(ships: [(ship: "automaton_raider", count: 2), (ship: "automaton_hunter")]),
            seeds: 4,
            time_limit: 60,
        ),
        (
            id: "raider_gauntlet",
            name: "Raider gauntlet",
            summary: "Four waves of automatons, each coming in when the one before is out: two raiders, three, a hunter and a raider, two hunters.",
            kind: Gauntlet(waves: [
                [(ship: "automaton_raider", count: 2)],
                [(ship: "automaton_raider", count: 3)],
                [(ship: "automaton_hunter"), (ship: "automaton_raider")],
                [(ship: "automaton_hunter", count: 2)],
            ]),
            seeds: 2,
            time_limit: 180,
        ),
        (
            id: "your_fleet",
            name: "Your fleet",
            summary: "Your own saved designs as opponents, FLEET's escorts picked first. Your escorts are allies, so it is off unless you want a sparring partner.",
            kind: Fleet,
            seeds: 2,
            time_limit: 60,
        ),
        (
            id: "champions",
            name: "Champions",
            summary: "The best designs of the lab's earlier runs.",
            kind: Champions(count: 4),
            seeds: 2,
            time_limit: 60,
        ),
        (
            id: "voyages",
            name: "Voyages",
            summary: "The voyages open to you, flown headless from start to home: the real thing, and about five times a fight's cost.",
            kind: Voyages,
            seeds: 2,
            time_limit: 10,
        ),
        (
            id: "arms_race",
            name: "Arms race",
            summary: "An enemy population evolves against yours in the run: your designs fight its best and its past champions, it fights your best, your past champions and your starts, so both keep getting better. It can drift from the enemies you meet, and it costs about twice a run.",
            kind: CoEvolution(size: 0.5, elites: 3, hall: 2, check_every: 10, champions_every: 5, mirror: true),
            seeds: 2,
            time_limit: 60,
        ),
    ],
    genes: [
        (id: "layout", name: "Layout", summary: "Move, turn and flip parts."),
        (id: "parts", name: "Parts", summary: "Add, remove and swap parts, of the categories left on."),
        (id: "armour", name: "Armour", summary: "Another armour material on a hull part."),
        (id: "power", name: "Power", summary: "A part's power priority: its tier one up or down, or its weight."),
        (id: "numbers", name: "Behavior numbers", summary: "The behavior's thresholds, distances and choices."),
        (id: "rules", name: "Behavior rules", summary: "The behavior's rules: add, remove, copy and reorder them, change their actions, conditions and the target line."),
        (id: "assist_numbers", name: "Assist numbers", summary: "The pilot assists' numbers and choices, and whether each is on at the start."),
        (id: "assist_rules", name: "Assist rules", summary: "The pilot assists' rules: add, remove and reorder them, change their assists and conditions."),
    ],
    gene_presets: [
        (id: "everything", name: "Everything", genes: ["layout", "parts", "armour", "power", "numbers", "rules", "assist_numbers", "assist_rules"]),
        (id: "design_only", name: "Design only", genes: ["layout", "parts", "armour", "power"]),
        (id: "behavior_only", name: "Behavior only", genes: ["numbers", "rules"]),
        (id: "assists_only", name: "Assists only", genes: ["assist_numbers", "assist_rules"]),
        (id: "numbers_only", name: "Numbers only", genes: ["numbers", "assist_numbers"]),
    ],
    pilots: [
        (
            id: "casual",
            name: "Casual",
            summary: "Locks the nearest enemy, flies at it until it is in reach, lets go of the stick for 3 s every 6 s and fires in bursts: 3 s on, 2 s off.",
            flies: (lock: true, close_to: 0.8, stick: Some((on: 3, off: 3)), fire: Some((on: 3, off: 2))),
        ),
        (
            id: "hands_off",
            name: "Hands off",
            summary: "Only steers at the nearest enemy: the lock and the triggers are the assists'.",
            flies: (close_to: 0.8, stick: Some((on: 1))),
        ),
        (
            id: "busy",
            name: "Busy",
            summary: "Locks the nearest enemy, flies at it until it is in reach and fires all the time.",
            flies: (lock: true, close_to: 0.8, stick: Some((on: 1)), fire: Some((on: 1))),
        ),
    ],
    palettes: [
        // The warden's shields, for the raiders and hunters too.
        (faction: "automatons", parts: ["shield_emitter"]),
    ],
    kinds: [
        (id: "encounters", name: "The enemies you meet", summary: "Every encounter of the voyages open to the career, each a fight against its ships at their largest count."),
        (id: "enemy_ships", name: "Enemy ships", summary: "Content ships tagged as enemies, a count of each, every pack a fight."),
        (id: "waves", name: "Test-range waves", summary: "A gauntlet sized to the design: waves as the test range sends them, one after the other, until it is out or time is up; WIN is the share of the target cleared."),
        (id: "gauntlet", name: "Gauntlet", summary: "Fixed waves, one after the other: the next comes in a few seconds after the one before has no running vessel left."),
        (id: "beat_your_start", name: "Beat your start", summary: "Every start of the run, flown by its own behavior, as the opponent."),
        (id: "fleet", name: "Your fleet", summary: "Your saved designs as opponents, FLEET's escorts first."),
        (id: "hall_of_fame", name: "Hall of fame", summary: "The run's own best designs so far, a bar that rises as the run goes on."),
        (id: "champions", name: "Champions", summary: "The best designs of the lab's earlier runs."),
        (id: "voyages", name: "Voyages", summary: "The voyages open to the career, flown headless from launch to home; the voyage's score is the trial's WIN."),
        (id: "co_evolution", name: "Arms race", summary: "An enemy population that evolves against yours in the same run, from an enemy faction's ships."),
    ],
    sizes: [
        (id: "quick", name: "Quick", summary: "A first look at where a run goes.", population: 16, generations: 20),
        (id: "standard", name: "Standard", summary: "The everyday run.", population: 32, generations: 50, default: true),
        (id: "deep", name: "Deep", summary: "Twice the children over twice the generations, four times the work: leave it running.", population: 64, generations: 100),
    ],
    measures: [
        (id: "top_speed", stat: "top_speed", summary: "Top speed along the direction with the most thrust: the engines' rating, so it changes only with the engine type."),
        (id: "acceleration", stat: "acceleration", summary: "Acceleration along the direction with the most thrust: thrust over mass."),
        (id: "weapon_reach", stat: "range", summary: "The reach of the longest gun with a clear line of fire."),
        (id: "build_points", stat: "build_points", summary: "The design's build points."),
        (id: "mass", stat: "mass", summary: "The mass of the main piece."),
        (id: "firepower", stat: "firepower", summary: "Damage per second of all the main piece's guns at full power, as if each were clear and powered."),
        (id: "hit_points", stat: "hp", summary: "The design's hit points."),
        (id: "parts", name: "Parts", summary: "The parts in the design."),
        (id: "rules", name: "Rules", summary: "The rules the behavior runs, at most the design's rule slots."),
        (id: "engage_distance", name: "Engage distance", unit: "m", summary: "How far the design keeps from the nearest enemy vessel, on average over its fights: close brawlers on one side, snipers on the other."),
    ],
    spreads: [
        (id: "design", axes: [(measure: "acceleration", min: 0, max: 24, cells: 8), (measure: "firepower", min: 0, max: 16, cells: 8)]),
        (id: "behavior", axes: [(measure: "engage_distance", min: 0, max: 160, cells: 8), (measure: "rules", min: 0, max: 12, cells: 6)]),
    ],
    budget: (layer_open: 10, elsewhere: 4),
)
