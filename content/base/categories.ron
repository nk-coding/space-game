// Part categories: palette tabs in the drydock and sections in the wiki. The order here is the display order.
// `color` is a system colour key from art/tokens.json (ship.system_colors) used for the parts' icons.
[
    (id: "hull", name: "Hull", summary: "Armor blocks and slopes that hold the ship together."),
    (id: "power", name: "Power", summary: "Reactors and capacitors that feed each piece's shared power pool.", color: "power"),
    (id: "weapons", name: "Weapons", summary: "Fixed guns that fire past the ship's nose.", color: "weapons"),
    (id: "defense", name: "Defense", summary: "Shields that soak up hits before they reach the hull.", color: "shields"),
    (id: "heat", name: "Heat", summary: "Radiators that dump heat into space.", color: "heat"),
    (id: "propulsion", name: "Propulsion", summary: "Engines that push and turn the ship.", color: "propulsion"),
    (id: "logic", name: "Logic", summary: "Cores that host a mind and run its behaviors.", color: "logic"),
    (id: "cargo", name: "Cargo", summary: "Space for salvage on the way home.", color: "cargo"),
]
