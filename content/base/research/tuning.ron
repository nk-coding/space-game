        unlocks: [PartStat(target: Part("thruster"), stat: "rated_speed", step: Percent(4))],
    ),
    // Energy weapons: the pulse laser fires a little faster (more damage per second). 3 % a step: at 5 % the chain was
    // worth 12 to 18 points on the skiff, more than a new part.
    (
        id: "pulse_rate_1",
