// Research nodes of the first playable loop (docs/plans/first-playable-loop.md 3.2). PLACEHOLDER NUMBERS (lead
// defaults, 13 Oct 2026; costs about halved by the slice tuning of the same day, GDR-0073, to fit what the starter's
// hold brings home: docs/results/slice-balance-2026-10-13.md): costs are research data per family (from salvage) and
// materials, paid at once; a node unlocks the moment it is paid (GDR-0063). The automaton plate stays locked;
// reactive armour and the capital frame take gate shards (`shards.ron`, 18 Oct 2026). The simulation vault opens
// the evolution lab (GDR-0092: in the logic family and cheap, 3 logic data, PLACEHOLDER).
[
    (
        id: "automaton_cannon",
        name: "Reverse-engineered cannon",
        summary: "Build the raiders' crude kinetic gun into your own ships.",
        family: "kinetic",
        kind: NewPart,
        cost: (data: {"kinetic": 3}),
        unlocks: [Part("reverse_engineered_cannon")], // the player's copy, a little slower (18 Oct 2026, GDR-0100)
    ),
    (
        id: "composite_plating",
        name: "Composite plating",
        summary: "Plating that is lighter and tougher than steel.",
        family: "hull",
        kind: Variant, // a sidegrade of steel plating: lighter and tougher, more build points
        cost: (data: {"hull": 8}),
        unlocks: [Material("composite")],
    ),
    (
        id: "beam_laser",
        name: "Beam laser",
        summary: "A continuous beam: strong, hungry and hot.",
        family: "energy",
        kind: NewPart,
        cost: (data: {"energy": 10}),
        unlocks: [Part("beam_laser")],
    ),
    (
        id: "fusion_reactor",
        name: "Fusion reactor",
        summary: "A big reactor with plenty of power that runs hot.",
        family: "power",
        kind: NewPart,
        cost: (data: {"power": 10}),
        unlocks: [Part("fusion_reactor"), Facility("fusion_workshop")], // the workshop upgrade that fabricates it and the torch drive (GDR-0108)
    ),
    (
        id: "torch_drive",
        name: "Torch drive",
        summary: "A big drive: hot, heavy and very fast.",
        family: "propulsion",
        kind: NewPart,
        cost: (data: {"propulsion": 10}),
        unlocks: [Part("torch_drive")],
    ),
    // The drive's reach on the galaxy map (GDR-0093, Niklas: 2.5 S at the start, 4 S with both). Costs: lead
    // placeholders (16 Oct 2026, GDR-0096); the first should come within the slice, as it reaches the Warden's gate.
    (
        id: "jump_calibration_1",
        name: "Jump calibration I",
        summary: "Tune the drive's field: every jump reaches further.",
        description: "Jumps start from home or any charted cluster; this one step takes all of them further on the galaxy map.",
        family: "propulsion",
        kind: Refinement,
        cost: (data: {"propulsion": 8}),
        unlocks: [JumpRange(0.75)],
    ),
    (
        id: "jump_calibration_2",
        name: "Jump calibration II",
        summary: "Tune the drive's field again: jumps reach as far as this drive goes.",
        family: "propulsion",
        kind: Refinement,
        cost: (data: {"propulsion": 16}, materials: {"programmable_matter": 3}),
        requires: ["jump_calibration_1"],
        unlocks: [JumpRange(0.75)],
    ),
    (
        id: "tamed_core",
        name: "Tamed automaton core",
        summary: "A cheap core for drones: few rules, little control.",
        description: "Rebuilds the feral [[part:automaton_core]] as a core the ship-mind can run.",
        family: "logic",
        kind: NewPart,
        cost: (data: {"logic": 3}, materials: {"programmable_matter": 1}),
        unlocks: [Part("automaton_core")],
    ),
    (
        id: "mind_expansion_1",
        name: "Mind expansion I",
        summary: "Run one more logic core at once.",
        family: "logic",
        kind: Refinement,
        cost: (data: {"logic": 10}, materials: {"programmable_matter": 3}),
        requires: ["tamed_core"],
        unlocks: [MindCapacity(1)],
    ),
    (
        id: "mind_expansion_2",
        name: "Mind expansion II",
        summary: "Run one more logic core at once.",
        family: "logic",
        kind: Refinement,
        cost: (data: {"logic": 16}, materials: {"programmable_matter": 5}),
        requires: ["mind_expansion_1"],
        unlocks: [MindCapacity(1)],
    ),
    (
        id: "simulation_vault",
        name: "Simulation vault",
        summary: "Wakes the compute stack above the mind: the evolution lab.",
        description: "Opens the [[facility:evolution]] lab at home. Its runs cost nothing.",
        family: "logic",
        kind: Facility,
        cost: (data: {"logic": 3}),
        unlocks: [Facility("evolution")],
    ),
    (
        id: "cruiser_drydock",
        name: "Cruiser drydock",
        summary: "Expand the drydock for line ships with several big machines.",
        family: "hull",
        kind: SizeClass,
        cost: (data: {"hull": 20}),
        requires: ["composite_plating"],
        unlocks: [Frame("cruiser")],
    ),
