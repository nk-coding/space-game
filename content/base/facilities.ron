// The home shipyard's facilities (GDR-0071 "each area needs states from content", GDR-0092): the buildings research
// opens. `name` is the label over the building at home; a `locked` one stays dark until a research node's
// `Facility(id)` opens it. The shipyard places and draws the buildings.
// The workshop (GDR-0108) holds the stock (the voyage's report keeps or dismantles the haul's intact parts) and
// fabricates new ones; its `workshop` rules are PLACEHOLDER NUMBERS (lead, 18 Oct 2026): an intact part dismantled gives back `dismantle` of its recipe's
// materials, a broken one (and a hull part, per cell of its armour) `broken`; the suggested sort keeps an intact part
// while fewer than `keep` are in stock or the fleet needs more. Facilities `within` the workshop are its upgrades
// (GDR-0031's hub upgrades): a recipe that `needs` one is fabricated only once it is open.
[
    (
        id: "workshop",
        name: "Workshop",
        summary: "Holds the parts your ships are fitted from and the materials in store, fabricates parts from materials and dismantles spare ones. The haul's intact parts come to its stock from the voyage's report.",
        description: "Ships are fitted from its stock: a fleet launches only when the stock holds every part its ships carry. Fitted parts come back to stock when the ship comes home, and re-form there when it is lost.",
        workshop: (dismantle: 0.4, broken: 0.25, keep: 2),
    ),
    (
        id: "fusion_workshop",
        name: "Fusion workshop",
        summary: "A workshop upgrade that fabricates fusion reactors and torch drives.",
        description: "Researching the [[research:fusion_reactor]] installs it in the [[facility:workshop]]. Until then these parts come only from intact salvage.",
        locked: true,
        within: "workshop",
    ),
    (
        id: "grown_vat",
        name: "Growing vat",
        summary: "A workshop upgrade that grows the Grown's living parts from their tissue.",
        description: "Researching [[research:living_weapons]] installs it in the [[facility:workshop]]. Until then these parts come only from intact salvage.",
        locked: true,
        within: "workshop",
    ),
    (
        id: "automaton_forge",
        name: "Automaton forge",
        summary: "A workshop upgrade that forges the automatons' own cores.",
        description: "Researching the [[research:automaton_forge]] installs it in the [[facility:workshop]] (it takes a [[material:gate_shard]]). Until then the automatons' parts come only from intact salvage.",
        locked: true,
        within: "workshop",
    ),
    // The munitions bay and the hive cradle (lead defaults, 20 Oct 2026; GDR-0031's hub upgrades, GDR-0108's list
    // that waited for parts): the bay fills the launchers' missiles and flares, the cradle grows the Swarm's parts.
    // The research that unlocks the first such part installs it, so no new node and no new cost.
    (
        id: "munitions_bay",
        name: "Munitions bay",
        summary: "A workshop upgrade that fabricates missile launchers and flare launchers with their warheads and decoys.",
        description: "Researching the [[research:rocket_pod]] or [[research:flares]] installs it in the [[facility:workshop]]. Until then the launchers come only from intact salvage.",
        locked: true,
        within: "workshop",
    ),
    (
        id: "hive_cradle",
        name: "Hive cradle",
        summary: "A workshop upgrade that grows the Swarm's parts from hive resin and nerve cores.",
        description: "Researching [[research:stingers]] installs it in the [[facility:workshop]]. Until then the Swarm's parts come only from intact salvage.",
        locked: true,
        within: "workshop",
    ),
    // The smelter (GDR-0114, GDR-0031's hub upgrade): refines the ores the mining laser cuts. The workshop pays a
    // material the store is short of from it (`refine`: `take` units of `from` give `give` of `to`; PLACEHOLDER, lead,
    // 19 Oct 2026), for parts and research alike.
    (
        id: "smelter",
        name: "Smelter",
        summary: "A workshop upgrade that refines mined ore: nickel-iron into steel, water ice into coolant.",
        description: "Researching the [[research:smelter]] installs it in the [[facility:workshop]]. Whenever a recipe or a research cost needs more [[material:steel]] or [[material:coolant]] than the store holds, it refines the rest from [[material:nickel_iron]] or [[material:water_ice]] in store.",
        locked: true,
        within: "workshop",
        refine: [
            (from: "nickel_iron", take: 2, to: "steel", give: 1),
            (from: "water_ice", take: 2, to: "coolant", give: 1),
        ],
    ),
    (
        id: "evolution",
        name: "Evolution",
        summary: "The evolution lab: it breeds your designs and behaviors against trials you pick, keeps every fight to watch again and saves the best as designs. Runs cost nothing.",
        description: "A stack of compute rings above the mind, joined to it by its violet conduit: the mind's own simulation. Research the [[research:simulation_vault]] to open it.",
        locked: true,
    ),
]
