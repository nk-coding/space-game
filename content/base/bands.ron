// The galaxy's bands from the rim inwards (GDR-0026), each a ring around the centre out to its `edge` (S). A band's
// clusters fill its ring at the galaxy's spacing; its `gates` lie near its inner edge, each at the end of a trail (the
// rim's first is the Warden's, a set piece whose trail is the slice's voyages, GDR-0098);
// `trails` adds caches, graveyards and the bosses' sites (lore trails come from `lore/`; a `spare` trail comes after
// them, in the clusters they leave free, GDR-0128). The rim and
// the outer reach are real (the outer reach's Grown, guardians and elders 18 Oct 2026, GDR-0103), and so is the
// middle band (the Swarm, 19 Oct 2026, GDR-0117), the inner band (the Lattice, 20 Oct 2026, GDR-0126; the Phase
// walkers, GDR-0127) and the core (the precursor defences and the Archive, 20 Oct 2026, GDR-0130). PLACEHOLDER NUMBERS (lead,
// 16 Oct 2026, GDR-0094; the outer reach's 18 Oct 2026, GDR-0103; the middle band's 19 Oct 2026, GDR-0117; the inner
// band's 20 Oct 2026, GDR-0126).
[
    (
        id: "rim",
        name: "The rim",
        summary: "The galaxy's dark edge, where the shipyard lies and automatons pick over what the precursors left.",
        edge: 5.5,
        clusters: [(id: "wreck_drift", weight: 3), (id: "hunting_reach", weight: 2), (id: "quiet_field", weight: 2)],
        gates: (count: 3, trail: "rim_gate"),
        trails: [(trail: "precursor_cache", count: 2), (trail: "graveyard", count: 2)],
        // The sky of its voyages and cluster types (GDR-0105).
        sky: (
            planets: [
                (kind: "rock", weight: 3), (kind: "ice_world", weight: 3), (kind: "ice_giant", weight: 3), (kind: "ringed", weight: 2),
                (kind: "desert", weight: 2), (kind: "eyeball", weight: 2), (kind: "jovian", weight: 1), (kind: "living", weight: 1),
                (kind: "ocean", weight: 1),
            ],
            moons: [(kind: "grey_moon", weight: 3), (kind: "icy_moon", weight: 3), (kind: "geyser_moon", weight: 2), (kind: "rubble_moon", weight: 2)],
            nebula: ("#1f7f8c", "#2c55a8"),
            nebula_core: "#6fd8c8",
            nebula_strength: 1.0,
            galaxy: 0.85,
        ),
    ),
    (
        id: "outer",
        name: "The outer reach",
        summary: "The band behind the rim's gates: the Grown's groves, hot stars, and rim stragglers near the border.",
        edge: 4.2,
        // `border`: rolled only within that many S of the band's outer edge (18 Oct 2026, GDR-0103).
        clusters: [
            (id: "grove_reach", weight: 3),
            (id: "scorched_deep", weight: 2),
            (id: "border_drift", weight: 4, border: 0.45),
        ],
        gates: (count: 3, trail: "outer_gate"),
        // A cache and a graveyard of the band's own after its lore (`spare`, GDR-0128).
        trails: [(trail: "elder_grove", count: 2), (trail: "overgrown_cache", count: 1, spare: true), (trail: "overgrown_fleet", count: 1, spare: true)],
        sky: (
            planets: [
                (kind: "garden", weight: 5), (kind: "living", weight: 2), (kind: "ocean", weight: 2), (kind: "eyeball", weight: 2),
                (kind: "ringed", weight: 1), (kind: "jovian", weight: 1), (kind: "ice_giant", weight: 1),
            ],
            moons: [(kind: "grey_moon", weight: 2), (kind: "icy_moon", weight: 2), (kind: "geyser_moon", weight: 1), (kind: "rubble_moon", weight: 1)],
            nebula: ("#6a3fb8", "#24946e"),
            nebula_core: "#c4a6ff",
            nebula_strength: 1.0,
            galaxy: 0.8,
        ),
    ),
    (
        id: "middle",
        name: "The middle band",
        summary: "Halfway to the core: the Swarm's band, where hive carriers flood the space with drones and the hives hum in the deep.",
        edge: 3.2,
        // The Swarm (19 Oct 2026, GDR-0117): `border` as the outer reach's (rolled only within 0.4 S of its outer edge).
        clusters: [
            (id: "swarm_reach", weight: 3),
            (id: "brood_deep", weight: 2),
            (id: "raided_border", weight: 4, border: 0.4),
        ],
        gates: (count: 3, trail: "deep_gate"),
        trails: [(trail: "swarm_hive", count: 2), (trail: "resin_cache", count: 1, spare: true), (trail: "picked_graveyard", count: 1, spare: true)],
        sky: (
            planets: [
                (kind: "jovian", weight: 3), (kind: "ice_giant", weight: 3), (kind: "ringed", weight: 2), (kind: "rock", weight: 2),
                (kind: "eyeball", weight: 1), (kind: "desert", weight: 1), (kind: "living", weight: 1),
            ],
            moons: [(kind: "grey_moon", weight: 3), (kind: "rubble_moon", weight: 2), (kind: "geyser_moon", weight: 1), (kind: "icy_moon", weight: 1)],
            nebula: ("#2c4fb8", "#7a9a2c"),
            nebula_core: "#9fd0ff",
            nebula_strength: 1.0,
            galaxy: 0.75,
        ),
    ),
    (
        id: "inner",
        name: "The inner band",
        summary: "Crowded space close to the core: the Lattice's crystal lances and the Phase walkers, one race to a cluster.",
        edge: 2.2,
        // Each cluster belongs to one faction, the Lattice or the Phase walkers, mixed across the band cluster by
        // cluster (Niklas, 20 Oct 2026). The Lattice's (GDR-0126) are the more common: the walkers' cluster types join
        // this list (GDR-0127) with less weight in all than the Lattice's 5.
        clusters: [
            (id: "lattice_reach", weight: 3),
            (id: "crystal_deep", weight: 2),
            (id: "phase_rift", weight: 2), // the Phase walkers' (GDR-0127)
        ],
        gates: (count: 3, trail: "inner_gate"), // the Spire (GDR-0116)
        // The band is small (6 to 12 clusters): its bosses first, then its lore, then a spare cache and graveyards in
        // the clusters left (GDR-0128).
        trails: [
            (trail: "lattice_resonator", count: 2),
            (trail: "phase_colossus", count: 1),
            (trail: "crystal_cache", count: 1, spare: true),
            (trail: "rift_graveyard", count: 1, spare: true),
            (trail: "crystal_wreck_field", count: 1, spare: true),
        ],
        sky: (
            planets: [
                (kind: "ice_giant", weight: 3), (kind: "ice_world", weight: 3), (kind: "ringed", weight: 2), (kind: "rock", weight: 2),
                (kind: "jovian", weight: 1), (kind: "eyeball", weight: 1),
            ],
            moons: [(kind: "icy_moon", weight: 3), (kind: "grey_moon", weight: 2), (kind: "geyser_moon", weight: 1), (kind: "rubble_moon", weight: 1)],
            nebula: ("#3a6fb8", "#8a6fc8"),
            nebula_core: "#d8ecff",
            nebula_strength: 1.0,
            galaxy: 0.7,
        ),
    ),
    (
        id: "core",
        name: "The core",
        summary: "The bright heart of the galaxy: radiation everywhere, the precursors' own defences, and their Archive at the very centre.",
        edge: 1.1,
        // The precursor defences (GDR-0130, decided by Niklas 20 Oct 2026; details lead defaults): patrols and sentry
        // posts, a megastructure's fragments; every cluster radiates (its type's `radiation`).
        clusters: [(id: "sentry_reach", weight: 3), (id: "fragment_deep", weight: 2)],
        // The Archive at the galaxy's centre: the band's cluster nearest it, the end of its own trail (GDR-0130).
        centre: (trail: "archive", cluster: "archive_heart"),
        // Its lore after the Archive, then a spare vault where a cluster is left (GDR-0128).
        trails: [(trail: "sealed_vault", count: 1, spare: true)],
        sky: (
            planets: [
                (kind: "rock", weight: 3), (kind: "desert", weight: 3), (kind: "eyeball", weight: 2), (kind: "jovian", weight: 1),
            ],
            moons: [(kind: "grey_moon", weight: 3), (kind: "rubble_moon", weight: 2), (kind: "geyser_moon", weight: 1)],
            nebula: ("#c89a4a", "#d0603a"),
            nebula_core: "#fff0c8",
            nebula_strength: 1.0,
            galaxy: 1.0,
            backlit: true,
        ),
    ),
]
