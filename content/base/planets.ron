// The planets and moons in a cluster's sky (GDR-0105): drawn far behind the play by the client, rolled from the
// cluster's seed, never a body. A cluster type's or a band's `sky` weights them. `form` picks the client's painter;
// each palette is one colour set (rolled per body), its colours read in the order the form documents
// (`data::PlanetForm`). PLACEHOLDER LOOKS (lead defaults from the design study Niklas approved, 17 Oct 2026).
[
    (
        id: "jovian",
        name: "Jovian giant",
        summary: "A gas giant in warm bands round a great red storm.",
        body: Planet,
        form: Jovian,
        palettes: [(colors: ["#b5523a", "#f2e8d8", "#c9a27a", "#ead8b8", "#9a6a4a", "#b88a5e", "#f1e4cc", "#7e5a44"], air: "#f0d0a0")],
        atmosphere: Moderate,
        rings: (chance: 0.3, color: "#8a7a68"),
    ),
    (
        id: "ringed",
        name: "Ringed giant",
        summary: "A pale banded giant inside wide bright rings.",
        body: Planet,
        form: Ringed,
        palettes: [(colors: ["#f5ecd5", "#d8c08a", "#ecdcb6", "#bfa06c", "#cfb27c", "#e2cc98"], air: "#f2deb0")],
        atmosphere: Moderate,
        rings: (chance: 1.0, color: "#e6d6b0", bright: true),
    ),
    (
        id: "ice_giant",
        name: "Ice giant",
        summary: "Deep blue or cyan haze over faint bands, now and then a dark spot.",
        body: Planet,
        form: IceGiant,
        palettes: [
            (colors: ["#1f3a80", "#3f6fd0", "#5a88e0", "#3360b8"], air: "#8fb8ff"),
            (colors: ["#4a9aae", "#7cc7d6", "#9adce6", "#6ab4c6"], air: "#b8f0f4"),
        ],
        atmosphere: Thick,
        rings: (chance: 0.4, color: "#5a6a80"),
    ),
    (
        id: "hot_giant",
        name: "Hot giant",
        summary: "A giant baked close to its star: dark red bands, its night side glowing.",
        body: Planet,
        form: HotGiant,
        palettes: [(colors: ["#e0803a", "#ff5a2a", "#6a2c26", "#94402c", "#3e1c20", "#b8582e", "#7a3424"], air: "#ff8a50")],
        atmosphere: Thick,
    ),
    (
        id: "living",
        name: "Living world",
        summary: "Blue seas, green land, white clouds and ice at the poles.",
        body: Planet,
        form: Living,
        palettes: [
            (colors: ["#1f4f86", "#3f8fb0", "#c8b07a", "#4f8a3a", "#8a7448"], air: "#78b4ff"),
            (colors: ["#1d4a80", "#3f8fb0", "#c8b07a", "#5d9440", "#6f8a40"], air: "#78b4ff"),
            (colors: ["#22548a", "#4596b4", "#c4aa76", "#3f7a3a", "#a08a5a"], air: "#7ab8ff"),
        ],
        atmosphere: Moderate,
    ),
    (
        id: "garden",
        name: "Alien garden",
        summary: "Seas and violet, teal or rust flora that glows on the night side.",
        body: Planet,
        form: Garden,
        palettes: [
            (colors: ["#1d3f5a", "#cfc29a", "#8a5ac8", "#c08ae8"], air: "#b0b8e0"),
            (colors: ["#23485a", "#cfc29a", "#2fa59a", "#7ae0c8"], air: "#8ce4c8"),
            (colors: ["#33285a", "#cfc29a", "#b0582e", "#e8a050"], air: "#c4c48c"),
            (colors: ["#1d4a48", "#cfc29a", "#b04a8a", "#f08ac0"], air: "#c4b8c4"),
            (colors: ["#1d3f5a", "#cfc29a", "#5a8a2a", "#c8e070"], air: "#b2e49c"),
        ],
        atmosphere: Moderate,
        rings: (chance: 0.2, color: "#b8b0c8"),
    ),
    (
        id: "ocean",
        name: "Ocean world",
        summary: "One sea round the whole world, a few islands and storm spirals.",
        body: Planet,
        form: Ocean,
        palettes: [
            (colors: ["#17507f", "#3fa0b8", "#d8c890", "#4f8a4a"], air: "#80c0ff"),
            (colors: ["#1a5f78", "#3fa0b8", "#d8c890", "#4f8a4a"], air: "#80c0ff"),
            (colors: ["#1c4470", "#3fa0b8", "#d8c890", "#4f8a4a"], air: "#80c0ff"),
        ],
        atmosphere: Thick,
    ),
    (
        id: "eyeball",
        name: "Eyeball world",
        summary: "Tidally locked: frozen all over but for an open sea facing its star.",
        body: Planet,
        form: Eyeball,
        palettes: [
            (colors: ["#dfe8f0", "#a08a6a", "#5f8a4a", "#3f9ab0", "#1f4f7a"], air: "#b0d8ff"),
            (colors: ["#dfe8f0", "#a08a6a", "#8a6a4a", "#3f9ab0", "#1f4f7a"], air: "#b0d8ff"),
            (colors: ["#dfe8f0", "#a08a6a", "#6a5a8a", "#3f9ab0", "#1f4f7a"], air: "#b0d8ff"),
        ],
        atmosphere: Thin,
    ),
    (
        id: "desert",
        name: "Desert world",
        summary: "Rust dunes and canyons under thin air.",
        body: Planet,
        form: Desert,
        palettes: [
            (colors: ["#b8673a", "#8a4a2e", "#d08a5a"], air: "#f0a878"),
            (colors: ["#c9925a", "#9a6a3e", "#e0b07a"], air: "#f0b888"),
            (colors: ["#a87a5a", "#7a5a44", "#c8a07a"], air: "#f0b898"),
        ],
        atmosphere: Thin,
    ),
    (
        id: "ice_world",
        name: "Ice world",
        summary: "A white crust split by rust-red cracks, no air at all.",
        body: Planet,
        form: Ice,
        palettes: [
            (colors: ["#e6dfd2", "#b8946a", "#9a5a3a"]),
            (colors: ["#d8e6f0", "#98b0c8", "#4a6a9a"]),
            (colors: ["#e8e4f0", "#b8a8d0", "#7a5a9a"]),
        ],
    ),
    (
        id: "lava",
        name: "Lava world",
        summary: "A black crust split by glowing rifts.",
        body: Planet,
        form: Lava,
        palettes: [(colors: ["#4a3328", "#ec8f7c", "#ffc878", "#7a4a30", "#8a7a3a", "#5a3a2c"], air: "#ff9060")],
        atmosphere: Thin,
    ),
    (
        id: "rock",
        name: "Cratered rock",
        summary: "Grey or tan rock, airless and pocked with craters.",
        body: Planet,
        form: Rock,
        palettes: [
            (colors: ["#8a8682", "#5e5a58", "#a8a4a0"]),
            (colors: ["#9a8a74", "#6a5c4c", "#b8a890"]),
            (colors: ["#7a7a86", "#55556a", "#9a9aac"]),
        ],
    ),
    (
        id: "toxic",
        name: "Toxic haze",
        summary: "Featureless smog under a thick glowing limb.",
        body: Planet,
        form: Toxic,
        palettes: [
            (colors: ["#c8b25a", "#e0cc80", "#a8903a"], air: "#e6d699"),
            (colors: ["#8aa23a", "#b0c860", "#6a8a2a"], air: "#c0d380"),
            (colors: ["#c87a3a", "#e0a060", "#a05a2a"], air: "#e6b380"),
        ],
        atmosphere: Thick,
    ),
    (
        id: "grey_moon",
        name: "Grey moon",
        summary: "Craters and dark maria.",
        body: Moon,
        form: Rock,
        palettes: [
            (colors: ["#8a8682", "#5e5a58", "#a8a4a0"]),
            (colors: ["#9a8a74", "#6a5c4c", "#b8a890"]),
            (colors: ["#7a7a86", "#55556a", "#9a9aac"]),
        ],
    ),
    (
        id: "icy_moon",
        name: "Icy moon",
        summary: "Cracked ice.",
        body: Moon,
        form: Ice,
        palettes: [
            (colors: ["#e6dfd2", "#b8946a", "#9a5a3a"]),
            (colors: ["#d8e6f0", "#98b0c8", "#4a6a9a"]),
        ],
    ),
    (
        id: "geyser_moon",
        name: "Geyser moon",
        summary: "Bright ice venting plumes at one pole.",
        body: Moon,
        form: Geyser,
        palettes: [(colors: ["#eef4fa", "#7ab8d8"])],
    ),
    (
        id: "sulfur_moon",
        name: "Sulfur moon",
        summary: "Yellow, volcanic, its vents glowing.",
        body: Moon,
        form: Sulfur,
        palettes: [(colors: ["#d8c060", "#c07a30", "#f0e0a0", "#3a2a1a", "#9a8a40"])],
    ),
    (
        id: "crystal_moon",
        name: "Crystal moon",
        summary: "Faceted, catching the light.",
        body: Moon,
        form: Crystal,
        palettes: [
            (colors: ["#7fd8e8", "#3a6a8a"]),
            (colors: ["#b8a0f0", "#4a3a7a"]),
            (colors: ["#9af0c8", "#2a6a5a"]),
        ],
    ),
    (
        id: "rubble_moon",
        name: "Rubble moon",
        summary: "An irregular captured rock.",
        body: Moon,
        form: Rubble,
        palettes: [
            (colors: ["#8a8682", "#5e5a58", "#a8a4a0"]),
            (colors: ["#9a8a74", "#6a5c4c", "#b8a890"]),
        ],
    ),
]
