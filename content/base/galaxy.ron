// The galaxy a game is generated from (GDR-0026, GDR-0078, GDR-0093, GDR-0094; the `galaxy` crate, ADR-0042). A
// new game generates it once from its seed and keeps the result in the save (ADR-0035). Distances in S (the spacing
// unit, `stats.ron`'s `galaxy_distance`), warp time in seconds. PLACEHOLDER NUMBERS (lead, 16 Oct 2026, GDR-0094)
// except the jump range and warp time, Niklas's (GDR-0093): 2.5 S at the start (two propulsion research nodes add
// 0.75 S each, track E4), 3 s + 2 s per S.
(
    id: "galaxy",
    name: "The galaxy",
    summary: "A spiral of five bands around a bright core, mostly dark: the shipyard lies at its rim.",
    lore: "You remember the shape of it. Nothing else.",
    bands: ["rim", "outer", "middle", "inner", "core"],
    spacing: 0.9,
    jump_range: 2.5,
    home_neighbours: 3,
    warp: (3, 2),
    signal_area: (across: (2, 3), offset: 0.6),
    trail_step: (0.9, 2.5),
    names: (
        starts: ["Hal", "Cor", "Var", "Tes", "Mor", "Kel", "Dra", "Os", "Vel", "Ist", "Ny", "Bra", "Sel", "Thar", "Quen", "Ar"],
        ends: ["vex", "ran", "dis", "sa", "ith", "on", "mar", "ek", "ira", "und", "ost", "ane"],
    ),
)
