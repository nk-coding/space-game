(
    id: "swarm_spitter",
    name: "Swarm spitter",
    summary: "A 4×4 Swarm gunship with two stingers in its nose and a thick chitin shell.",
    description: "Spitters patrol the middle band in small packs and close in to circle what they find, stinging. Their two [[part:swarm_node|nerve nodes]] are their salvage: each leaves a [[material:nerve_core]].",
    tags: ["swarm", "middle"],
    faction: "swarm",
    behavior: "swarm_spitter",
    size: (4, 4),
    parts: [
        (part: "slope_1x1", x: 0, y: 0, flip: true, material: "chitin"),
        (part: "stinger", x: 1, y: 0),
        (part: "stinger", x: 2, y: 0),
        (part: "slope_1x1", x: 3, y: 0, material: "chitin"),
        (part: "armor_block", x: 0, y: 1, material: "chitin"),
        (part: "armor_block", x: 1, y: 1, material: "chitin"),
        (part: "armor_block", x: 2, y: 1, material: "chitin"),
        (part: "armor_block", x: 3, y: 1, material: "chitin"),
        (part: "armor_block", x: 0, y: 2, material: "chitin"),
        (part: "swarm_node", x: 1, y: 2),
        (part: "swarm_node", x: 2, y: 2),
        (part: "armor_block", x: 3, y: 2, material: "chitin"),
        (part: "slope_1x1", x: 0, y: 3, rot: 2, material: "chitin"),
        (part: "swarm_jet", x: 1, y: 3),
        (part: "swarm_jet", x: 2, y: 3),
        (part: "slope_1x1", x: 3, y: 3, rot: 2, flip: true, material: "chitin"),
    ],
)
