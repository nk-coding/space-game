        (part: "armor_block", x: 4, y: 1, material: "chitin"),
        (part: "armor_block", x: 5, y: 1, material: "chitin"),
        (part: "slope_1x1", x: 6, y: 1, material: "chitin"),
        (part: "brood_hangar", x: 0, y: 2, rot: 3),
        (part: "armor_block", x: 2, y: 2, material: "chitin"),
        (part: "armor_block", x: 3, y: 2, material: "chitin"),
        (part: "armor_block", x: 4, y: 2, material: "chitin"),
        (part: "brood_hangar", x: 5, y: 2, rot: 1),
        (part: "swarm_node", x: 2, y: 3),
