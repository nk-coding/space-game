// Stat descriptors: label, unit, precision and which direction is better. The order here is the display
// order of stat lines in the drydock, tooltips and the wiki.
// Units are placeholders until the sim fixes its units (only 1 cell = 1 m is decided).
[
    (id: "build_points", name: "Build points", summary: "How big and costly the part is. No budget limits a design's total: it measures designs against each other, and the test range sizes its raider waves from it.", unit: "BP", decimals: 1, better: Lower),
    (id: "control_cost", name: "Control cost", summary: "How much of its vessel's control capacity the part uses. Parts beyond the capacity go idle, lowest power priority first.", decimals: 0, better: Lower),
    (id: "mass", name: "Mass", summary: "Weight of the part. Heavier ships turn and accelerate slower.", unit: "t", decimals: 2, better: Lower),
    (id: "hp", name: "Hit points", summary: "Damage the part takes before it is destroyed.", unit: "HP", decimals: 2, better: Higher),
    (id: "power_output", name: "Power output", summary: "Power the part adds to its piece's shared pool.", unit: "MW", decimals: 1, better: Higher),
    (id: "power_draw", name: "Power draw", summary: "Power the part takes from its piece's pool at full load.", unit: "MW", decimals: 1, better: Lower),
    (id: "power_min_level", name: "Minimum power", summary: "Below this share of its draw the part switches off instead of running at partial output.", unit: "%", decimals: 0, better: Lower),
    (id: "heat_output", name: "Heat", summary: "Heat the part adds at full load.", decimals: 2, better: Lower),
    (id: "heat_limit", name: "Heat limit", summary: "Heat level at which the part shuts down.", decimals: 1, better: Higher),
    (id: "heat_vent", name: "Venting", summary: "How fast a radiator sheds heat through each side open to space: a coefficient, not an amount. Each open side loses this much heat per second for every unit of heat the radiator holds.", decimals: 1, better: Higher),
    (id: "damage", name: "Damage", summary: "Damage per second at full power, before bonuses.", unit: "/s", decimals: 1, better: Higher),
    (id: "range", name: "Range", summary: "How far the weapon reaches.", unit: "m", decimals: 0, better: Higher),
    (id: "shot_rate", name: "Shots", summary: "Shots per second at full power, before bonuses.", unit: "/s", decimals: 1, better: Higher),
    (id: "shot_speed", name: "Shot speed", summary: "Speed of the projectile, on top of the ship's own.", unit: "m/s", decimals: 0, better: Higher),
    (id: "penetration", name: "Penetration", summary: "Blocks a projectile hits, the first included: one that breaks a block carries the damage left into the next, up to this many. At 1 it stops in the first block.", decimals: 0, better: Higher),
    (id: "recoil", name: "Recoil", summary: "Push on the ship per shot.", unit: "kN·s", decimals: 1, better: Lower),
    (id: "fire_rate", name: "Fire rate", summary: "How fast a weapon fires. Raised by adjacency bonuses.", decimals: 0, better: Higher),
    (id: "thrust", name: "Thrust", summary: "Push of an engine at full power.", unit: "kN", decimals: 0, better: Higher),
    (id: "rated_speed", name: "Rated speed", summary: "Ship speed at which the engine's thrust has faded out while it pushes with the ship's motion. The fastest engines set the ship's top speed. Braking keeps full thrust; turning with the gimbal, or by thrusting harder on one side, fades with the push.", unit: "m/s", decimals: 1, better: Higher),
    (id: "gimbal", name: "Gimbal", summary: "How far an engine can swing its thrust to either side to help turn the ship.", unit: "°", decimals: 1, better: Higher),
    (id: "plume_length", name: "Plume length", summary: "How far the exhaust reaches behind the engine. The plume burns the first part in its path, the ship's own included.", unit: "m", decimals: 1, better: Neutral),
    (id: "plume_damage", name: "Plume damage", summary: "Damage per second the exhaust deals to the first part in its path at full thrust.", unit: "/s", decimals: 1, better: Neutral),
    (id: "plume_heat", name: "Plume heat", summary: "Heat per second the exhaust puts into the first part in its path at full thrust.", unit: "/s", decimals: 1, better: Neutral),
    (id: "rcs_thrust", name: "Thrust per nozzle", summary: "Push of each RCS nozzle; a nozzle fires from every side open to space.", unit: "kN", decimals: 1, better: Higher),
    (id: "rcs_rated_speed", name: "Rated speed", summary: "Ship speed at which a nozzle's thrust has faded out while it pushes with the ship's motion; braking and nozzle pairs that only turn the ship keep full thrust.", unit: "m/s", decimals: 1, better: Higher),
    (id: "torque", name: "Torque", summary: "Turning force without thrust, in either direction.", unit: "kN·m", decimals: 0, better: Higher),
    (id: "blast_damage", name: "Blast damage", summary: "Damage the part's explosion deals once to every part within the blast radius when it is destroyed, on its own ship and on any other. The ship's own shields do not help, other ships' do; armour takes its share and shields the parts behind it.", unit: "HP", decimals: 2, better: Lower),
    (id: "blast_radius", name: "Blast radius", summary: "How far the explosion reaches from the part's centre, to the nearest point of a cell: 1 m takes the eight cells around a one-cell part, 1.5 m also the next cell straight out on each side.", unit: "m", decimals: 1, better: Lower),
    (id: "shield_capacity", name: "Shield", summary: "Damage the bubble takes before it collapses.", unit: "HP", decimals: 1, better: Higher),
    (id: "shield_regen", name: "Shield regen", summary: "Shield capacity regained per second while powered.", unit: "HP/s", decimals: 1, better: Higher),
    (id: "shield_radius", name: "Shield radius", summary: "Radius of the shield bubble around the emitter.", unit: "m", decimals: 1, better: Higher),
    (id: "cargo_capacity", name: "Cargo", summary: "Units of salvage the part holds.", unit: "units", decimals: 0, better: Higher),
    (id: "rule_slots", name: "Rule slots", summary: "Behavior rules the core can run.", decimals: 0, better: Higher),
    (id: "control_capacity", name: "Control capacity", summary: "Control cost of parts the core can run; a vessel's capacity is the sum over its running cores.", decimals: 0, better: Higher),
    (id: "mass_per_cell", name: "Mass per cell", summary: "Mass of one full cell of this armor; slopes count half a cell per footprint cell.", unit: "t", decimals: 2, better: Lower),
    (id: "hp_per_cell", name: "Hit points per cell", summary: "Hit points of one full cell of this armor.", unit: "HP", decimals: 2, better: Higher),
    (id: "build_point_factor", name: "Build point factor", summary: "Multiplies the build points of hull parts made of this armor.", unit: "×", decimals: 2, better: Lower),
    (id: "blast_factor", name: "Blast damage taken", summary: "Share of an explosion's damage that hull parts of this armor take, and that they let through to the parts behind them.", unit: "×", decimals: 2, better: Lower),
    // Ship-level stats of the drydock's stats panel (data::stats::SHIP_STATS; the sim's design report computes
    // them). The panel shows build points, mass, hit points, cargo and rule slots with the part stats above.
    // Units, precision and the summaries' definitions are placeholders (lead, 12 Oct 2026).
    (id: "power_use", name: "Power", summary: "Power the parts draw at full load, shown against what the ship's reactors make.", unit: "MW", decimals: 1, better: Neutral),
    (id: "peak_heat", name: "Peak heat", summary: "How hot the hottest part runs at full load, as a share of its shutdown limit.", unit: "%", decimals: 0, better: Lower),
    (id: "acceleration", name: "Thrust/mass", summary: "Forward thrust divided by mass: how quickly the ship gains speed.", unit: "m/s²", decimals: 2, better: Higher),
    (id: "top_speed", name: "Top speed", summary: "Fastest speed along the ship's best thrust direction, set by the rated speed of the engines pushing that way.", unit: "m/s", decimals: 1, better: Higher),
    (id: "turn_time", name: "Turn 90°", summary: "Time to turn a quarter circle from rest, with every turning source at full power.", unit: "s", decimals: 1, better: Lower),
    (id: "yaw", name: "Yaw", summary: "How evenly the thrust pushes around the centre of mass; uneven thrust turns the ship while it accelerates.", decimals: 2, better: Neutral),
    (id: "firepower", name: "Firepower", summary: "Damage per second of all guns together at full power, with bonuses.", unit: "/s", decimals: 1, better: Higher),
    (id: "control_load", name: "Control", summary: "Control cost of the parts against the capacity of the logic cores; parts beyond it go idle.", decimals: 0, better: Neutral),
    (id: "device_load", name: "Device load", summary: "How heavy the design is to simulate on this device; very heavy designs can slow the game down.", decimals: 0, better: Neutral),
    // The galaxy map's distances (GDR-0093). S, the spacing unit, is about the distance between two neighbouring
    // clusters: the first playable loop's voyages lie 0.9-1.3 S apart on the voyage map (1 S is 200 of its px).
    (id: "galaxy_distance", name: "Distance", summary: "A distance on the galaxy map, in S: about the distance between two neighbouring clusters.", unit: "S", decimals: 2, better: Neutral),
    (id: "jump_range", name: "Jump range", summary: "How far the drive jumps on the galaxy map, from home or any charted cluster.", unit: "S", decimals: 2, better: Higher),
]
