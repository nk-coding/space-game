// Stat descriptors: label, unit, precision and which direction is better. The order here is the display
// order of stat lines in the drydock, tooltips and the wiki.
// Units are placeholders until the sim fixes its units (only 1 cell = 1 m is decided).
[
    (id: "build_points", name: "Build points", summary: "Cost against the drydock's build-point budget.", unit: "BP", decimals: 1, better: Lower),
    (id: "mass", name: "Mass", summary: "Weight of the part. Heavier ships turn and accelerate slower.", unit: "t", decimals: 2, better: Lower),
    (id: "hp", name: "Hit points", summary: "Damage the part takes before it is destroyed.", unit: "HP", decimals: 2, better: Higher),
    (id: "power_output", name: "Power output", summary: "Power the part adds to its piece's shared pool.", unit: "MW", decimals: 1, better: Higher),
    (id: "power_draw", name: "Power draw", summary: "Power the part takes from its piece's pool at full load.", unit: "MW", decimals: 1, better: Lower),
    (id: "heat_output", name: "Heat", summary: "Heat the part adds at full load.", decimals: 2, better: Lower),
    (id: "heat_limit", name: "Heat limit", summary: "Heat level at which the part shuts down.", decimals: 1, better: Higher),
    (id: "heat_vent", name: "Venting", summary: "Heat a radiator dumps through each side open to space.", decimals: 1, better: Higher),
    (id: "damage", name: "Damage", summary: "Damage per second at full power, before bonuses.", unit: "/s", decimals: 1, better: Higher),
    (id: "fire_rate", name: "Fire rate", summary: "How fast a weapon fires. Raised by adjacency bonuses.", decimals: 0, better: Higher),
    (id: "thrust", name: "Thrust", summary: "Push of an engine at full power.", unit: "kN", decimals: 0, better: Higher),
    (id: "gimbal", name: "Gimbal", summary: "How far an engine can swing its thrust to either side to help turn the ship.", unit: "°", decimals: 1, better: Higher),
    (id: "rcs_thrust", name: "Thrust per nozzle", summary: "Push of each RCS nozzle; a nozzle fires from every side open to space.", unit: "kN", decimals: 1, better: Higher),
    (id: "torque", name: "Torque", summary: "Turning force without thrust, in either direction.", unit: "kN·m", decimals: 0, better: Higher),
    (id: "shield_radius", name: "Shield radius", summary: "Radius of the shield bubble around the emitter.", unit: "m", decimals: 1, better: Higher),
    (id: "cargo_capacity", name: "Cargo", summary: "Units of salvage the part holds.", unit: "units", decimals: 0, better: Higher),
    (id: "rule_slots", name: "Rule slots", summary: "Behavior rules the core can run.", decimals: 0, better: Higher),
    (id: "mass_per_cell", name: "Mass per cell", summary: "Mass of one full cell of this armor; slopes count half a cell per footprint cell.", unit: "t", decimals: 2, better: Lower),
    (id: "hp_per_cell", name: "Hit points per cell", summary: "Hit points of one full cell of this armor.", unit: "HP", decimals: 2, better: Higher),
    (id: "build_point_factor", name: "Build point factor", summary: "Multiplies the build points of hull parts made of this armor.", unit: "×", decimals: 2, better: Lower),
]
