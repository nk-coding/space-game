// PLACEHOLDER (lead, 17 Oct 2026).
[
    (
        id: "nickel_iron",
        name: "Nickel-iron",
        summary: "Metal ore locked in asteroid rock.",
        icon: "ore-nickel-iron",
        description: "The dark [[rock:iron_rock|iron rock]] and the glassy [[rock:slag_rock|slag]] near hot stars are mostly nickel-iron: a [[part:mining_laser]] cuts it out. The [[facility:smelter]] refines it into [[material:steel]], and researching the smelter takes some.",
    ),
    (
        id: "water_ice",
        name: "Water ice",
        summary: "Dirty ice from the pale rocks of quiet clusters.",
        icon: "ore-water-ice",
        description: "[[rock:ice_rock|Ice rock]] is mostly water ice: a [[part:mining_laser]] cuts it out. The [[facility:smelter]] refines it into [[material:coolant]].",
    ),
]
