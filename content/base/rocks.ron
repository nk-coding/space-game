// Kinds of asteroid rock (GDR-0104). A cluster type's or a voyage's `scenery.rocks` places them; each rock is rolled
// from its kind when the fleet warps in: a convex outline of `corners` corners round a radius of `size` metres, each
// corner pulled in by up to `roughness` of it, stretched along its long axis by `stretch`, its edges dented in by up
// to `dent` (a rock dented deeply collides as two or three convex pieces). Rocks are anchored bodies:
// they block ships, shots and plumes and give cover, and a ship that hits one takes ramming damage like any ram
// (GDR-0047) times `ram`: an anchored rock gives nothing, so a ram on it would hurt as much as on a ship of infinite
// mass, and `ram` scales what the ship takes as a ram prow's factors do (ice crumbles more). `material` is what mining
// will give (GDR-0031; none yet). `tone` is a key into art/tokens.json world.rock (shadow, mid, lit and edge colours);
// `look` is what the client draws on it: a crater per `crater_every` m of radius, a ridge, a metal glint on the lit
// side, bright cracks, small pits and ember veins on the shadow side (GDR-0104's status line of 18 Oct 2026).
// PLACEHOLDER NUMBERS (lead defaults, 17 Oct 2026; `ram` set with the slice's balance runs,
// docs/results/scenery-2026-10-17.md; `dent` and `look` from the backdrop study, 18 Oct 2026).
[
    (
        id: "iron_rock",
        name: "Iron rock",
        summary: "Dark, heavy nickel-iron rock: good cover, and hard to ram.",
        material: "nickel_iron",
        size: (6, 22),
        corners: (6, 10),
        roughness: 0.3,
        stretch: (1.0, 1.6),
        dent: 0.07,
        ram: 0.5,
        tone: "iron",
        look: (crater_every: 3.6, ridge: true, glint: 0.16, cracks: 0, pits: 0, embers: 0),
    ),
    (
        id: "ice_rock",
        name: "Ice rock",
        summary: "Pale rock of dirty ice, smaller and rounder than iron.",
        material: "water_ice",
        size: (4, 15),
        corners: (5, 8),
        roughness: 0.22,
        stretch: (1.0, 1.4),
        dent: 0.04,
        ram: 0.35,
        tone: "ice",
        look: (crater_every: 7.0, ridge: false, glint: 0.0, cracks: 3, pits: 0, embers: 0),
    ),
    (
        id: "slag_rock",
        name: "Slag",
        summary: "Rock fused glassy and long by a hot star's heat.",
        material: "nickel_iron",
        size: (5, 18),
        corners: (5, 9),
        roughness: 0.4,
        stretch: (1.3, 2.4),
        dent: 0.16,
        ram: 0.5,
        tone: "slag",
        look: (crater_every: 5.0, ridge: true, glint: 0.0, cracks: 0, pits: 12, embers: 3),
    ),
]
