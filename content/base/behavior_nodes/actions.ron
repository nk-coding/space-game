// Behavior actions (teal in the editor): the maneuver a ship flies while its rule is active. Built into the
// sim (`sim::behavior`); the flight computer turns them into thrust. Whatever the action, guns fire at will: each
// gun whenever the target (or its lead point) is in front of that gun and within its reach.
// An action that needs a target fails while there is none, and the next rule gets its turn.
// PLACEHOLDER defaults and ranges (for feel).
[
    (
        id: "approach",
        name: "Approach",
        summary: "Close in to the given distance, then face the target and keep pace.",
        description: "Aims at the lead point when your strongest guns fire projectiles.",
        tags: ["move", "attack"],
        role: Action,
        params: [
            (id: "range", name: "Range", summary: "Stand-off distance: metres, or a share of your weapon reach.", type: Distance, default: "67%", min: 0, max: 5000),
        ],
    ),
    (
        id: "orbit",
        name: "Orbit",
        summary: "Circle the target at the given radius.",
        description: "As fast as the ship can hold the turn. Each gun fires whenever the target passes in front of it, within its reach.",
        tags: ["move"],
        role: Action,
        params: [
            (id: "radius", name: "Radius", summary: "Metres, or a share of your weapon reach.", type: Distance, default: "60%", min: 1, max: 5000),
            (id: "dir", name: "Direction", type: Choice([
                (id: "auto", name: "Auto", summary: "Half of a fleet circles each way; two ships circling each other go the same way."),
                (id: "ccw", name: "Counter-clockwise"),
                (id: "cw", name: "Clockwise"),
            ]), default: "auto"),
        ],
    ),
    (
        id: "kite",
        name: "Keep distance",
        summary: "Hold the given distance from the target: back off when it closes in, follow when it pulls away.",
        description: "A ship that can thrust backwards (RCS pods) keeps its nose on the target while it backs off; one with engines only at the back turns away to open the gap and turns back to fight.",
        tags: ["move", "attack"],
        role: Action,
        params: [
            (id: "range", name: "Range", summary: "Metres, or a share of your weapon reach.", type: Distance, default: "90%", min: 0, max: 5000),
        ],
    ),
    (
        id: "face",
        name: "Face target",
        summary: "Turn the nose onto the target (or its lead point) and match its velocity.",
        tags: ["attack"],
        role: Action,
    ),
    (
        id: "flee",
        name: "Flee",
        summary: "Run straight away from the target at top speed.",
        tags: ["move"],
        role: Action,
    ),
    // The Grown's charge (GDR-0099 A2, GDR-0103, 18 Oct 2026); anyone may fly it.
    (
        id: "ram",
        name: "Ram",
        summary: "Charge the target nose first at top speed and fly on through it.",
        description: "The nose points straight at the target and the ship never brakes for it, so it hits as hard as it can: build something tough in the nose, such as a [[part:ram_prow|ram prow]]. Mix it with a cycle so the ship pulls away between charges.",
        tags: ["move", "attack"],
        role: Action,
    ),
    (
        id: "hold",
        name: "Hold",
        summary: "Stop and stay put.",
        description: "Needs no target. Each gun still fires if the target passes in front of it, within its reach.",
        tags: ["move"],
        role: Action,
    ),
    (
        id: "escort",
        name: "Escort",
        summary: "Stay within the given distance of your leader: close in when farther, keep pace when near.",
        description: "Needs no target: it follows the leader, the ship this one escorts (for wingmen the player's flagship). Without a leader it holds where it is. Guns still fire at will if there is a target. Put it last, below the rules that fight, so it runs between fights.",
        tags: ["move", "escort"],
        role: Action,
        params: [
            (id: "distance", name: "Distance", summary: "How far from the leader it may be: metres, or a share of your weapon reach.", type: Distance, default: "30m", min: 5, max: 5000),
        ],
    ),
    (
        id: "scan",
        name: "Scan",
        summary: "Start a scan with the ship's scanner, then let the next rule fly the ship.",
        description: "Needs no target and never decides the maneuver: while its conditions hold it starts a scan whenever the [[part:scanner|scanner]] is ready (charged for a moment, then a sweep, then the cooldown), and the next rule that holds flies the ship meanwhile. A ship without a working scanner skips it. A sweep wakes sleeping enemies close by, so a rule like `when enemies_near(300m) < 1 -> scan` scans only where it is quiet.",
        tags: ["scan"],
        role: Action,
    ),
    // Mining (GDR-0114); like `scan` it needs no target ship.
    (
        id: "mine",
        name: "Mine nearest rock",
        summary: "Fly to the nearest asteroid rock with ore left and cut it with the mining lasers.",
        description: "Needs no target: it picks the nearest rock within sensor range that still holds ore, closes to its mining lasers' reach and holds them on it; the other guns hold fire. A ship without a working [[part:mining_laser]], with a full hold, or with no such rock in sight skips it, and the next rule gets its turn. Put it below the rules that fight, so a ship mines between fights: `when enemies_near(300m) < 1 -> mine`.",
        tags: ["move", "mining"],
        role: Action,
    ),
    // Flares (GDR-0115); like `scan` it needs no target and never decides the maneuver.
    (
        id: "flare",
        name: "Flare",
        summary: "Release flares from the ship's flare launcher, then let the next rule fly the ship.",
        description: "Needs no target and never decides the maneuver: while its conditions hold it releases flares whenever a [[part:flare_launcher]] on the ship is ready (charged and cooled down), and the next rule that holds flies the ship meanwhile. A launcher has only a few releases per fight, so keep it for missiles: `when missiles_incoming >= 1 -> flare` at the top of the list. A ship without a working launcher skips it.",
        tags: ["defence"],
        role: Action,
    ),
    // EMP burst and overdrive (GDR-0132); like `flare` they need no target and never decide the maneuver.
    (
        id: "emp",
        name: "EMP burst",
        summary: "Release a ring of static from the ship's EMP emitter, then let the next rule fly the ship.",
        description: "Needs no target and never decides the maneuver: while its conditions hold it releases a burst whenever an [[part:emp_emitter]] on the ship is recharged, and the next rule that holds flies the ship meanwhile. Every enemy vessel in reach takes static; drones fall apart. The recharge is long, so keep it for a crowd: `when enemies_near(150m) >= 4 -> emp` at the top of the list. A ship without a working emitter skips it.",
        tags: ["defence", "disruption"],
        role: Action,
    ),
    (
        id: "overdrive",
        name: "Overdrive",
        summary: "Drive every part past its limits for a few seconds, then let the next rule fly the ship.",
        description: "Needs no target and never decides the maneuver: while its conditions hold it starts an overdrive whenever the ship is not overdriven or cooling down from one, and the next rule that holds flies the ship. For a few seconds every part works harder (thrust, power, fire, shield regeneration), but heat climbs fast and parts past their heat limit burn; a burning reactor can blow. Pair it with [[behavior_node:heat]] so a hot ship does not cook itself: `when heat < 40% and target_in_range(100%) -> overdrive`.",
        tags: ["defence"],
        role: Action,
    ),
    // Blink (GDR-0127); like `flare` it never decides the maneuver, but it needs a target to jump by.
    (
        id: "blink",
        name: "Blink",
        summary: "Start a blink with the ship's blink drives, behind the target or away from it, then let the next rule fly the ship.",
        description: "Never decides the maneuver: while its conditions hold and a target is picked it starts a blink whenever the ship's [[part:blink_drive|blink drives]] are ready (enough of them cool to carry the ship), and the next rule that holds flies the ship while the drives charge. Then the ship jumps, keeping its speed and heading: `behind` to a spot behind the target's tail (as far as the drives reach), `away` the full reach straight away from it. Where rocks or ships fill the spot it lands short, or not at all. Pair it with [[behavior_node:blink_ready]] so the rule only holds when it can act: `when blink_ready and target_in_range(70m) -> blink(away)`. A ship without a working drive skips it.",
        tags: ["move", "phase"],
        role: Action,
        params: [
            (id: "to", name: "Where", type: Choice([
                (id: "behind", name: "Behind the target", summary: "To a spot behind the target's tail, as far as the drives reach."),
                (id: "away", name: "Away from the target", summary: "The drives' full reach straight away from the target."),
            ]), default: "behind"),
        ],
    ),
    // Salvage (GDR-0123); like `mine` it needs no target ship. No tractor: the hull strips what it passes over slowly.
    (
        id: "salvage",
        name: "Salvage nearest wreck",
        summary: "Fly slowly over the nearest wreck or loose fragment with something your hold can take, so the ship strips it.",
        description: "Needs no target: it picks the nearest salvage within sensor range that drifts slowly and holds a part, fragment or cargo that fits your free hold, and settles over it; the ship collects as it does whenever it passes slowly over salvage. Guns still fire at will at the target. With a full hold, or nothing that fits in sight, it skips, and the next rule gets its turn. Put it below the rules that fight: `when enemies_near(300m) < 1 -> salvage`. Only the player's ships collect; another side's ship flies there and takes nothing.",
        tags: ["move", "salvage"],
        role: Action,
    ),
]
