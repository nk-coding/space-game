// Behavior actions (teal in the editor): the maneuver a ship flies while its rule is active. Built into the
// sim (`sim::behavior`); the flight computer turns them into thrust. Whatever the action, guns fire at will: each
// gun whenever the target (or its lead point) is in front of that gun and within its reach.
// An action that needs a target fails while there is none, and the next rule gets its turn.
// PLACEHOLDER defaults and ranges (for feel).
[
    (
        id: "approach",
        name: "Approach",
        summary: "Close in to the given distance, then face the target and keep pace.",
        description: "Aims at the lead point when your strongest guns fire projectiles.",
        tags: ["move", "attack"],
        role: Action,
        params: [
            (id: "range", name: "Range", summary: "Stand-off distance: metres, or a share of your weapon reach.", type: Distance, default: "67%", min: 0, max: 5000),
        ],
    ),
    (
        id: "orbit",
        name: "Orbit",
        summary: "Circle the target at the given radius.",
        description: "As fast as the ship can hold the turn. Each gun fires whenever the target passes in front of it, within its reach.",
        tags: ["move"],
        role: Action,
        params: [
            (id: "radius", name: "Radius", summary: "Metres, or a share of your weapon reach.", type: Distance, default: "60%", min: 1, max: 5000),
            (id: "dir", name: "Direction", type: Choice([
                (id: "auto", name: "Auto", summary: "Half of a fleet circles each way; two ships circling each other go the same way."),
                (id: "ccw", name: "Counter-clockwise"),
                (id: "cw", name: "Clockwise"),
            ]), default: "auto"),
        ],
    ),
    (
        id: "kite",
        name: "Keep distance",
        summary: "Hold the given distance from the target: back off when it closes in, follow when it pulls away.",
        description: "A ship that can thrust backwards (RCS pods) keeps its nose on the target while it backs off; one with engines only at the back turns away to open the gap and turns back to fight.",
        tags: ["move", "attack"],
        role: Action,
        params: [
            (id: "range", name: "Range", summary: "Metres, or a share of your weapon reach.", type: Distance, default: "90%", min: 0, max: 5000),
        ],
    ),
    (
        id: "face",
        name: "Face target",
        summary: "Turn the nose onto the target (or its lead point) and match its velocity.",
        tags: ["attack"],
        role: Action,
    ),
    (
        id: "flee",
        name: "Flee",
        summary: "Run straight away from the target at top speed.",
        tags: ["move"],
        role: Action,
    ),
    (
        id: "hold",
        name: "Hold",
        summary: "Stop and stay put.",
        description: "Needs no target. Each gun still fires if the target passes in front of it, within its reach.",
        tags: ["move"],
        role: Action,
    ),
    (
        id: "escort",
        name: "Escort",
        summary: "Stay within the given distance of your leader: close in when farther, keep pace when near.",
        description: "Needs no target: it follows the leader, the ship this one escorts (for wingmen the player's flagship). Without a leader it holds where it is. Guns still fire at will if there is a target. Put it last, below the rules that fight, so it runs between fights.",
        tags: ["move", "escort"],
        role: Action,
        params: [
            (id: "distance", name: "Distance", summary: "How far from the leader it may be: metres, or a share of your weapon reach.", type: Distance, default: "30m", min: 5, max: 5000),
        ],
    ),
    (
        id: "scan",
        name: "Scan",
        summary: "Start a scan with the ship's scanner, then let the next rule fly the ship.",
        description: "Needs no target and never decides the maneuver: while its conditions hold it starts a scan whenever the [[part:scanner|scanner]] is ready (charged for a moment, then a sweep, then the cooldown), and the next rule that holds flies the ship meanwhile. A ship without a working scanner skips it. A sweep wakes sleeping enemies close by, so a rule like `when enemies_near(300m) < 1 -> scan` scans only where it is quiet.",
        tags: ["scan"],
        role: Action,
    ),
]
