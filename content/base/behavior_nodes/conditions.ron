// Behavior conditions (violet in the editor): what a rule checks before the arrow. Built into the sim
// (`sim::behavior`); every id here needs an implementation there and vice versa. A condition with a `value`
// yields a number that a rule compares (`hull < 30%`); one without is a flag (`shield_down`).
// Conditions about the target are false while there is no target, with or without `not`.
// PLACEHOLDER defaults and ranges (for feel).
[
    (
        id: "hull",
        name: "Hull",
        summary: "Your hull integrity: hit points left on the controlling piece, as a share of the intact ship.",
        description: "Parts lost with pieces that broke off count as lost.",
        tags: ["self"],
        role: Condition,
        value: Percent,
    ),
    (
        id: "shield",
        name: "Shield charge",
        summary: "Charge left in your shield bubbles, as a share of their capacity.",
        description: "False while the ship has no working [[part:shield_emitter|shield emitter]].",
        tags: ["self", "shields"],
        role: Condition,
        value: Percent,
    ),
    (
        id: "shield_down",
        name: "Shield down",
        summary: "One of your shield bubbles has collapsed and is recharging.",
        tags: ["self", "shields"],
        role: Condition,
    ),
    (
        id: "heat",
        name: "Heat",
        summary: "Heat of your hottest part, as a share of the level where it shuts down.",
        description: "At 100% that part has shut down until it cools off.",
        tags: ["self"],
        role: Condition,
        value: Percent,
    ),
    (
        id: "power",
        name: "Power",
        summary: "Share of your power demand the reactors can serve.",
        description: "Below 100% the ship browns out: weapons lose power first, the logic cores last.",
        tags: ["self"],
        role: Condition,
        value: Percent,
    ),
    (
        id: "target_in_range",
        name: "Target in range",
        summary: "The target is within the given distance; by default, within your weapon reach.",
        tags: ["target"],
        role: Condition,
        params: [
            (id: "range", name: "Range", summary: "Metres, or a share of your weapon reach (100% = the reach of your longest working gun).", type: Distance, default: "100%", min: 0, max: 5000),
        ],
    ),
    (
        id: "target_hull",
        name: "Target hull",
        summary: "The target's hull integrity, as a share of its intact ship.",
        tags: ["target"],
        role: Condition,
        value: Percent,
    ),
    (
        id: "target_on_me",
        name: "Target on me",
        summary: "The target is aiming at you: its pilot's lock or its behavior's target is your ship.",
        tags: ["target"],
        role: Condition,
    ),
    (
        id: "under_attack",
        name: "Under attack",
        summary: "At least one enemy ship is aiming at you.",
        tags: ["self"],
        role: Condition,
    ),
    (
        id: "off_leash",
        name: "Off the leash",
        summary: "This drone is farther from its carrier than its hangar's leash.",
        description: "Only drones are ever off the leash (GDR-0117): a drone flies what its carrier aims at, and this turns it back when the chase takes it too far. False for every other ship.",
        tags: ["self"],
        role: Condition,
    ),
    (
        id: "enemies_near",
        name: "Enemies near",
        summary: "How many active enemy ships are within the radius.",
        tags: ["surroundings"],
        role: Condition,
        value: Count,
        params: [
            (id: "radius", name: "Radius", summary: "Metres, or a share of your weapon reach.", type: Distance, default: "150m", min: 0, max: 5000),
        ],
    ),
    (
        id: "missiles_incoming",
        name: "Missiles incoming",
        summary: "How many enemy missiles are homing on your ship.",
        description: "Counts every live missile whose seeker has picked your ship (GDR-0115), however far off. A missile a flare lured away no longer counts.",
        tags: ["surroundings"],
        role: Condition,
        value: Count,
    ),
    (
        id: "cycle",
        name: "Cycle",
        summary: "Seconds into the current cycle, counted from when you picked your target.",
        description: "Compare it to alternate between two rules: `cycle(9s) >= 5s` holds for the last four seconds of every nine.",
        tags: ["timer"],
        role: Condition,
        value: Seconds,
        params: [
            (id: "period", name: "Period", summary: "Length of one cycle.", type: Seconds, default: "10s", min: 1, max: 600),
        ],
    ),
    (
        id: "target_time",
        name: "Time on target",
        summary: "Seconds since you picked your current target.",
        tags: ["timer", "target"],
        role: Condition,
        value: Seconds,
    ),
    (
        id: "speed",
        name: "Speed",
        summary: "How fast you fly, as a share of your top speed.",
        description: "The top speed is that of the thrusters along your best axis. Nothing to measure while none of them can push.",
        tags: ["self", "flight"],
        role: Condition,
        value: Percent,
    ),
    (
        id: "can_stop_straight",
        name: "Can stop straight",
        summary: "You can stop without turning: thrusters already push against your motion.",
        description: "True while you stand still. A small sideways share of the motion needs no thruster of its own. A ship with engines only at the back has to turn around to stop.",
        tags: ["self", "flight"],
        role: Condition,
    ),
    // The pilot's own conditions (`pilot: true`): only in a design's PILOT ASSISTS (GDR-0088).
    (
        id: "lock_held",
        name: "Lock held",
        summary: "You hold a lock on a ship or a piece.",
        tags: ["pilot"],
        role: Condition,
        pilot: true,
    ),
    (
        id: "idle",
        name: "Idle",
        summary: "Seconds since you last used a control: turning, thrust, the triggers, or any of them.",
        description: "Counts from the start of the mission while you haven't. Under a lock the turn keys only nudge the aim, which doesn't count as turning.",
        tags: ["pilot", "timer"],
        role: Condition,
        value: Seconds,
        pilot: true,
        params: [
            (id: "control", name: "Control", type: Choice([
                (id: "any", name: "Any", summary: "Turning, thrust or a trigger."),
                (id: "turn", name: "Turning", summary: "Turning the ship (A / D, or the touch stick)."),
                (id: "thrust", name: "Thrust", summary: "Thrust and strafe (W / S / Q / E, or the touch stick)."),
                (id: "fire", name: "Triggers", summary: "Any fire trigger."),
            ]), default: "any"),
        ],
    ),
]
