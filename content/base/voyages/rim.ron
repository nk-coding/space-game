// The voyages of the first playable loop (GDR-0062): four small rim clusters in a chain, each opened by clearing the
// goal of the one before it (the first is open at the start, `starts.ron`). The order here is the voyage map's.
// Radius and spacing in metres, `map` a place on the voyage map (0 to 1), `minutes` the expected length.
// PLACEHOLDER NUMBERS (docs/plans/slice-content.md 3.3, track 7J draft of 13 Oct 2026; sites tuned with the headless
// voyage runner the same day, GDR-0073 and docs/results/slice-balance-2026-10-13.md).
[
    (
        id: "yard_approach",
        name: "Shipyard approach",
        summary: "The quiet lanes outside the shipyard, where a few raiders pick over old wrecks.",
        band: "rim",
        map: (0.28, 0.66),
        radius: 600,
        spacing: (400, 700),
        minutes: (6, 8),
        cleared: "The lanes around the shipyard are quiet again. Further out, the [[voyage:halvex_drift]] is waiting.",
        sites: [
            (encounter: "raider_pair", count: 2),
            (encounter: "derelict_field"),
            (encounter: "raider_pair", goal: true),
        ],
    ),
    (
        id: "halvex_drift",
        name: "Halvex Drift",
        summary: "A raider-haunted drift of wrecks one warp out from the shipyard.",
        band: "rim",
        map: (0.44, 0.30),
        opens_after: ["yard_approach"],
        radius: 900,
        spacing: (400, 700),
        minutes: (6, 10),
        cleared: "The raiders' den is broken. Their hunters still hold the [[voyage:corran_reach]].",
        sites: [
            (encounter: "raider_pair"),
            (encounter: "precursor_wrecks"),
            (encounter: "core_graveyard"),
            (encounter: "raider_den", goal: true),
        ],
    ),
    (
        id: "corran_reach",
        name: "Corran Reach",
        summary: "A long reach of broken hulls where heavier automatons hunt in packs.",
        band: "rim",
        map: (0.62, 0.52),
        opens_after: ["halvex_drift"],
        radius: 1000,
        spacing: (400, 700),
        minutes: (5, 8),
        cleared: "The hunters are scattered. Beyond the Reach, something old still keeps the gate.",
        sites: [
            (encounter: "hunter_pack"),
            (encounter: "precursor_wrecks"),
            (encounter: "hunter_den", goal: true),
        ],
    ),
    (
        id: "wardens_gate",
        name: "The Warden's gate",
        summary: "The gate to the outer reach, and the old guardian that still keeps it.",
        band: "rim",
        map: (0.80, 0.34),
        opens_after: ["corran_reach"],
        radius: 900,
        spacing: (400, 700),
        minutes: (6, 10),
        cleared: "The Warden goes dark. The gate behind it stays cold: whatever opened it once is gone.",
        sites: [
            (encounter: "raider_pack"),
            (encounter: "core_graveyard"),
            (encounter: "the_warden", goal: true),
        ],
    ),
]
