// The voyages of the first playable loop (GDR-0062): four small rim clusters in a chain, each opened by clearing the
// goal of the one before it (the first is open at the start, `starts.ron`). The order here is the voyage map's.
// Radius and spacing in metres, `minutes` the expected length. They are set pieces of the galaxy (`galaxy.ron`'s
// `set_pieces`, GDR-0098): each lies on a rim cluster that takes its name, and the Warden's gate is the rim's first
// gate, its four voyages the gate's trail: clearing the Warden opens the outer reach.
// PLACEHOLDER NUMBERS (track 7J draft of 13 Oct 2026; sites tuned with the headless
// voyage runner the same day, GDR-0073 and docs/results/slice-balance-2026-10-13.md; re-measured 17 Oct 2026, Corran
// Reach's hunter packs 1 -> 2, docs/results/slice-balance-2026-10-17.md; the first two voyages' raiders became gunners
// and Corran Reach gained a gunner pair the same day, GDR-0101, docs/results/slice-balance-2026-10-17b.md).
[
    (
        id: "yard_approach",
        name: "Shipyard approach",
        summary: "The quiet lanes outside the shipyard, where a few raiders pick over old wrecks.",
        band: "rim",
        radius: 600,
        spacing: (400, 700),
        minutes: (6, 8),
        cleared: "The lanes around the shipyard are quiet again. Further out, the [[voyage:halvex_drift]] is waiting.",
        sites: [
            (encounter: "gunner_pair", count: 2),
            (encounter: "derelict_field"),
            (encounter: "raiding_party", goal: true),
        ],
        scenery: (
            rocks: [(rock: "iron_rock", layout: Field(radius: 110), count: (1, 1), rocks: (8, 12))],
            dust: 1.0,
            debris: 1.4,
            derelicts: (2, 4),
            landmarks: [(landmark: "derelict_station", chance: 0.6)],
            fights: 0.3,
        ),
    ),
    (
        id: "halvex_drift",
        name: "Halvex Drift",
        summary: "A raider-haunted drift of wrecks one warp out from the shipyard.",
        band: "rim",
        opens_after: ["yard_approach"],
        radius: 900,
        spacing: (400, 700),
        minutes: (6, 10),
        cleared: "The gunners' den is broken. Their hunters still hold the [[voyage:corran_reach]].",
        sites: [
            (encounter: "gunner_pair"),
            (encounter: "precursor_wrecks"),
            (encounter: "core_graveyard"),
            (encounter: "gunner_den", goal: true),
        ],
        scenery: (
            rocks: [
                (rock: "iron_rock", layout: Field(radius: 150), count: (1, 1), rocks: (10, 16)),
                (rock: "iron_rock", layout: Scatter, count: (1, 1), rocks: (6, 10)),
            ],
            dust: 1.2,
            debris: 1.6,
            derelicts: (3, 5),
            landmarks: [(landmark: "junk_ring", chance: 0.5)],
            fights: 0.5,
        ),
    ),
    (
        id: "corran_reach",
        name: "Corran Reach",
        summary: "A long reach of broken hulls where heavier automatons hunt in packs.",
        band: "rim",
        opens_after: ["halvex_drift"],
        radius: 1000,
        spacing: (400, 700),
        minutes: (6, 9), // 5-8 until 17 Oct 2026 (its gunner pair: the scripted run's median 4.1 min, doubled 8.2)
        cleared: "The hunters are scattered. Beyond the Reach, something old still keeps the gate.",
        sites: [
            (encounter: "hunter_pack", count: 2),
            (encounter: "gunner_pair"),
            (encounter: "precursor_wrecks"),
            (encounter: "hunter_den", goal: true),
        ],
        scenery: (
            rocks: [(rock: "iron_rock", layout: Belt(width: 120), count: (1, 1), rocks: (14, 20))],
            dust: 0.9,
            debris: 1.2,
            derelicts: (2, 4),
            landmarks: [(landmark: "silent_beacon", chance: 0.5)],
            fights: 0.8,
        ),
    ),
    (
        id: "wardens_gate",
        name: "The Warden's gate",
        summary: "The gate to the outer reach, and the old guardian that still keeps it.",
        band: "rim",
        opens_after: ["corran_reach"],
        radius: 900,
        spacing: (400, 700),
        minutes: (6, 10),
        cleared: "The Warden goes dark, and the gate behind it wakes for the first time since the last launch. The outer reach is open.",
        sites: [
            (encounter: "raider_pack"),
            (encounter: "core_graveyard"),
            (encounter: "the_warden", goal: true),
        ],
        scenery: (
            dust: 0.8,
            debris: 1.0,
            derelicts: (1, 3),
            landmarks: [(landmark: "derelict_station", chance: 1.0)],
            fights: 0.4,
        ),
    ),
]
