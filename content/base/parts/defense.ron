// Defense. PLACEHOLDER NUMBERS (concept-board drydock values, for feel only; the shield radius matches the
// rings of the concept art; capacity, regen, absorb and the minimum power level are invented).
// Power tier (lead default): shields before engines and guns. Below a quarter of its draw the bubble cannot hold.
// `salvage`: what the part gives when salvaged and dismantled at home (research data about its build points;
// PLACEHOLDER, lead defaults of 13 Oct 2026 after docs/plans/first-playable-loop.md 3.2).
// `recipe`: what the workshop fabricates it from (GDR-0108; PLACEHOLDER amounts, about twice the build points);
// `needs` names the workshop upgrade it takes. Dismantling gives a share back (facilities.ron).
[
    (
        id: "shield_emitter",
        name: "Shield emitter",
        summary: "Projects a shield bubble over the hull around it.",
        description: "Overlapping bubbles stack. Energy shots are absorbed well, kinetic shots partly pass.",
        tags: ["shield"],
        category: "defense",
        icon: "shield-emitter",
        size: (1, 1),
        build_points: 3,
        mass: 2,
        hp: 1,
        power: (draw: 3, tier: High, min_level: 0.25),
        heat: (output: 0.8, limit: 3.2),
        // Capacity 3 -> 2 on 17 Oct 2026 (Niklas, GDR-0021/GDR-0100: about one collapse in six waves under sustained
        // fire; docs/results/slice-balance-2026-10-17b.md).
        shield: (radius: 2.3, capacity: 2, regen: 0.2, absorb: {Energy: 1.0, Kinetic: 0.5, Missile: 1.0}),
        // Its stored field lets go: twice a capacitor's blast, the same reach (PLACEHOLDER, lead default,
        // 14 Oct 2026, GDR-0085).
        explosion: (damage: 1, radius: 0.6),
        salvage: (family: "shields", data: 3),
        recipe: (materials: {"copper": 2, "crystal": 3, "steel": 1}),
    ),
    // The wide-bubble emitter (18 Oct 2026, GDR-0024's variant; the `wide_bubble` node): a bubble half again as
    // wide that holds a little more but refills slower and draws more. PLACEHOLDER (lead defaults).
    (
        id: "wide_shield_emitter",
        name: "Wide-bubble emitter",
        summary: "A shield emitter with a bubble half again as wide that refills slowly.",
        description: "Covers far more of the hull than a [[part:shield_emitter]] and holds a little more, but it refills at about half the speed and draws more power. Overlapping bubbles stack.",
        tags: ["shield"],
        locked: true, // the shields research's `wide_bubble` unlocks it
        category: "defense",
        icon: "wide-shield-emitter",
        size: (1, 1),
        build_points: 4,
        mass: 2.5,
        hp: 1,
        power: (draw: 4, tier: High, min_level: 0.25),
        heat: (output: 1, limit: 3.2),
        shield: (radius: 3.4, capacity: 2.4, regen: 0.12, absorb: {Energy: 1.0, Kinetic: 0.5, Missile: 1.0}),
        explosion: (damage: 1, radius: 0.6),
        salvage: (family: "shields", data: 4),
        recipe: (materials: {"copper": 3, "crystal": 4, "steel": 1}),
    ),
]
