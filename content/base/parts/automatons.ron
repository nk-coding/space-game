        icon: "automaton-cannon",
        color: "enemy",
        barrel: (width: 0.2, length: 0.6, muzzle: 0.15), // as in art/ships/automaton-raider.svg
        size: (1, 1),
        build_points: 3,
        mass: 2,
        hp: 1,
        power: (draw: 2, tier: Low),
        heat: (output: 1, limit: 3),
        weapon: (family: Kinetic, damage: 1.2, range: 75, delivery: Projectile(rate: 1.5, speed: 90, penetration: 1, recoil: 2)),
        salvage: (family: "kinetic", data: 3),
