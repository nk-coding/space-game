// Parts of the rogue automatons. PLACEHOLDER NUMBERS (invented for feel; no concept-board values exist). The core
// torque makes the raider the snappiest base ship (agility target, GDR-0042, 12 Oct 2026).
// They use the enemy (coral) system colour instead of their category's.
// `salvage`: what the part gives when salvaged and dismantled at home (research data about its build points;
// PLACEHOLDER, lead defaults of 13 Oct 2026 after docs/plans/first-playable-loop.md 3.2).
// Cores also give programmable matter, and a destroyed core leaves a fragment of it to scoop (GDR-0063).
// `recipe`: what the workshop fabricates it from (GDR-0108; PLACEHOLDER amounts, about twice the build points);
// `needs` names the workshop upgrade it takes. Dismantling gives a share back (facilities.ron).
[
    (
        id: "automaton_core",
        name: "Automaton core",
        summary: "The feral mind and power plant of a rogue automaton.",
        description: "A precursor drone core gone wild. Salvaged cores are the first source of [[material:programmable_matter|programmable matter]] for new [[part:logic_core|logic cores]].",
        tags: ["automaton", "core"],
        locked: true, // not in a new game until research unlocks it (Niklas, 13 Oct 2026; GDR-0063)
        category: "logic",
        icon: "automaton-core",
        color: "enemy",
        size: (1, 1),
        build_points: 5,
        mass: 3,
        hp: 2,
        power: (output: 6),
        heat: (output: 1, limit: 4),
        logic: (rule_slots: 2, control_capacity: 4), // control capacity: lead placeholder (12 Oct 2026)
        sensor: (range: 800), // lead default, 16 Oct 2026 (GDR-0095)
        gyro: (torque: 300), // 13 Oct 2026 (GDR-0055): the raider turns 90° in ~0.57 s, still the snappiest
        // A power plant: it goes off like a fission reactor (PLACEHOLDER, lead default, 14 Oct 2026, GDR-0085).
        explosion: (damage: 1.5, radius: 1.5),
        salvage: (family: "logic", data: 4, fragment: {"programmable_matter": 1}),
        recipe: (materials: {"automaton_plate": 3, "copper": 1, "crystal": 1, "programmable_matter": 3}, needs: "automaton_forge"),
    ),
    (
        id: "automaton_cannon",
        name: "Automaton cannon",
        summary: "A crude kinetic gun that rogue automatons build into their noses.",
        tags: ["automaton"],
        locked: true,
        category: "weapons",
        icon: "automaton-cannon",
        color: "enemy",
        barrel: (width: 0.2, length: 0.6, muzzle: 0.15), // as in the concept art
        size: (1, 1),
        build_points: 3,
        mass: 2,
        hp: 1,
        power: (draw: 2, tier: Low),
        heat: (output: 1, limit: 3),
        // `damage` is per second, so a shot deals damage / rate. 14 Oct 2026 (GDR-0074): rate 1.5 → 1.2 and speed
        // 90 → 150 (a shot 0.8 → 1 hit point: it takes a gun off in one hit; the same damage per second), so the
        // reverse-engineered cannon is an upgrade for the starter (docs/results/slice-balance-2026-10-13.md).
        weapon: (family: Kinetic, damage: 1.2, range: 75, delivery: Projectile(rate: 1.2, speed: 150, penetration: 1, recoil: 2)),
        salvage: (family: "kinetic", data: 3),
        recipe: (materials: {"automaton_plate": 4, "copper": 1, "steel": 2}, needs: "automaton_forge"),
    ),
    // The inner gate's guardian's ward (GDR-0116): a shield emitter grown from Lattice crystal (GDR-0027's refractive
    // crystal) that takes energy fire whole and lets most shells and missiles through, so kinetic and missile fits
    // matter at the inner gate. Enemy only for now: no research unlocks it. PLACEHOLDER NUMBERS (lead
    // default, 19 Oct 2026, docs/results/spire-balance-2026-10-19.md).
    (
        id: "prism_ward",
        name: "Prism ward",
        summary: "A precursor shield emitter of grown crystal: its bubble bends energy fire away and lets shells through.",
        description: "Its bubble takes laser fire whole and holds far more than a [[part:shield_emitter]], but most of a cannon's shell or a missile's warhead passes it. Lasers wear it down slowly; guns and missiles go through.",
        tags: ["automaton", "shield"],
        locked: true,
        category: "defense",
        icon: "prism-ward",
        color: "enemy",
        size: (1, 1),
        build_points: 6,
        mass: 3,
        hp: 2,
        power: (draw: 4, tier: High, min_level: 0.25),
        heat: (output: 0.5, limit: 3),
        shield: (radius: 2.6, capacity: 20, regen: 1.5, absorb: {Energy: 1.0, Kinetic: 0.2, Missile: 0.25}),
        explosion: (damage: 1, radius: 0.6),
        salvage: (family: "shields", data: 6),
        recipe: (materials: {"automaton_plate": 2, "copper": 2, "crystal": 8}, needs: "automaton_forge"),
    ),
]
