// Weapons. PLACEHOLDER NUMBERS (damage from the concept-board drydock; range, delivery and rates invented), for
// feel only.
// Guns are fixed: they fire along the part's forward side and need a clear line of fire.
// Power tier (lead default): guns come last. A beam below half its draw cannot hold focus (placeholder).
// `salvage`: what the part gives when salvaged and dismantled at home (research data about its build points;
// PLACEHOLDER, lead defaults of 13 Oct 2026 after docs/plans/first-playable-loop.md 3.2).
// `recipe`: what the workshop fabricates it from (GDR-0108; PLACEHOLDER amounts, about twice the build points);
// `needs` names the workshop upgrade it takes. Dismantling gives a share back (facilities.ron).
[
    (
        id: "pulse_laser",
        name: "Pulse laser",
        summary: "A fixed forward laser that fires quick pulses.",
        description: "Needs a clear line of fire. [[part:capacitor|Capacitors]] beside it make it fire faster.",
        tags: ["laser"],
        category: "weapons",
        icon: "pulse-laser",
        size: (1, 1),
        build_points: 3,
        mass: 2,
        hp: 1,
        power: (draw: 4, tier: Low),
        heat: (output: 1.5, limit: 3),
        weapon: (family: Energy, damage: 1, range: 60, delivery: Pulse(rate: 4)),
        salvage: (family: "energy", data: 3),
        recipe: (materials: {"copper": 3, "crystal": 2, "steel": 1}),
    ),
    (
        id: "beam_laser",
        name: "Beam laser",
        summary: "A continuous beam: strong, hungry and hot.",
        locked: true, // mid-game: a new game starts without it, research unlocks it (Niklas, 13 Oct 2026, GDR-0063)
