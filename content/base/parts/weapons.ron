// Weapons. PLACEHOLDER NUMBERS (damage from the concept-board drydock; range, delivery and rates invented), for
// feel only.
// Guns are fixed: they fire along the part's forward side and need a clear line of fire.
// Power tier (lead default): guns come last. A beam below half its draw cannot hold focus (placeholder).
// `salvage`: what the part gives when salvaged and dismantled at home (research data about its build points;
// PLACEHOLDER, lead defaults of 13 Oct 2026 after docs/plans/first-playable-loop.md 3.2).
// `recipe`: what the workshop fabricates it from (GDR-0108; PLACEHOLDER amounts, about twice the build points);
// `needs` names the workshop upgrade it takes. Dismantling gives a share back (facilities.ron).
[
    (
        id: "pulse_laser",
        name: "Pulse laser",
        summary: "A fixed forward laser that fires quick pulses.",
        description: "Needs a clear line of fire. [[part:capacitor|Capacitors]] beside it make it fire faster.",
        tags: ["laser"],
        category: "weapons",
        icon: "pulse-laser",
        size: (1, 1),
        build_points: 3,
        mass: 2,
        hp: 1,
        power: (draw: 4, tier: Low),
        heat: (output: 1.5, limit: 3),
        weapon: (family: Energy, damage: 1, range: 60, delivery: Pulse(rate: 4)),
        salvage: (family: "energy", data: 3),
        recipe: (materials: {"copper": 3, "crystal": 2, "steel": 1}),
    ),
    (
        id: "beam_laser",
        name: "Beam laser",
        summary: "A continuous beam: strong, hungry and hot.",
        locked: true, // mid-game: a new game starts without it, research unlocks it (Niklas, 13 Oct 2026, GDR-0063)
        description: "Needs a clear line of fire. [[part:capacitor|Capacitors]] beside it make it fire faster.",
        tags: ["laser"],
        category: "weapons",
        icon: "beam-laser",
        barrel: (width: 0.25, length: 0.7, muzzle: 0.15), // as in the concept art
        size: (1, 2),
        build_points: 7,
        control_cost: 2, // big machine: lead placeholder (12 Oct 2026)
        mass: 4,
        hp: 2,
        power: (draw: 9, tier: Low, min_level: 0.5),
        heat: (output: 3.2, limit: 4.2),
        weapon: (family: Energy, damage: 2.6, range: 45, delivery: Beam),
        salvage: (family: "energy", data: 7),
        recipe: (materials: {"copper": 6, "crystal": 6, "steel": 2}),
    ),
    (
        id: "reverse_engineered_cannon",
        name: "Reverse-engineered cannon",
        summary: "A copy of the automatons' crude kinetic gun, built in your own shipyard.",
        // 18 Oct 2026 (Niklas, GDR-0100's status): the player's own copy of `automaton_cannon` so the gun can be
        // toned down without touching the automatons. Rate and damage 1.2 → 1.1 (a shot still 1 hit point: below it
        // a hit no longer takes a gun off and the gun is worse than the pulse laser), so the cannon starter clears
        // the Warden about 28 % (docs/results/slice-balance-2026-10-18.md). PLACEHOLDER.
        description: "Copied from the [[part:automaton_cannon|automaton cannon]] and a little slower to fire. Needs a clear line of fire. [[part:ammo_feeder|Ammo feeders]] beside it make it fire faster.",
        tags: ["cannon"], // the ammo feeder's bonus target (18 Oct 2026); the automatons' own cannon has none
        locked: true, // research unlocks it (`automaton_cannon` in research/rim.ron)
        category: "weapons",
        icon: "automaton-cannon",
        barrel: (width: 0.2, length: 0.6, muzzle: 0.15),
        size: (1, 1),
        build_points: 3,
        mass: 2,
        hp: 1,
        power: (draw: 2, tier: Low),
        heat: (output: 1, limit: 3),
        weapon: (family: Kinetic, damage: 1.1, range: 75, delivery: Projectile(rate: 1.1, speed: 150, penetration: 1, recoil: 2)),
        salvage: (family: "kinetic", data: 3),
        recipe: (materials: {"automaton_plate": 3, "copper": 1, "steel": 2}),
    ),
    // The sidegrades of 18 Oct 2026 (GDR-0024's variants, GDR-0018's kinetic support part). PLACEHOLDER NUMBERS
    // (lead defaults, within the range of the parts above; `damage` is per second, so a shot is damage / rate).
    // The burst laser: faster and harder hitting, but short and hot (the `burst_laser` node).
    (
        id: "burst_laser",
        name: "Burst laser",
        summary: "A pulse laser that fires fast bursts: more damage, a shorter reach and more heat.",
        description: "Needs a clear line of fire. Hits about a third harder than the [[part:pulse_laser]] at two thirds of its reach, and runs hot. [[part:capacitor|Capacitors]] beside it make it fire faster.",
        tags: ["laser"],
        locked: true, // the energy research's `burst_laser` unlocks it
        category: "weapons",
        icon: "burst-laser",
        size: (1, 1),
        build_points: 3,
        mass: 2,
        hp: 1,
        power: (draw: 5, tier: Low),
        heat: (output: 2.2, limit: 3),
        weapon: (family: Energy, damage: 1.3, range: 40, delivery: Pulse(rate: 7)),
        salvage: (family: "energy", data: 3),
        recipe: (materials: {"copper": 3, "crystal": 3, "steel": 1}),
    ),
    // The long-barrel cannon: reach and a heavy, piercing shot for its rate (the `long_cannon` node, after the
    // reverse-engineered cannon). A big machine, like the beam laser.
    (
        id: "long_cannon",
        name: "Long-barrel cannon",
        summary: "A 1×2 cannon with a long barrel: it reaches far and hits hard, but fires slowly.",
        description: "Needs a clear line of fire. Reaches about half again as far as the [[part:reverse_engineered_cannon]] with faster shells that hit harder and go through two blocks, at about half its rate of fire. [[part:ammo_feeder|Ammo feeders]] beside it make it fire faster.",
        tags: ["cannon"],
        locked: true, // the kinetic research's `long_cannon` unlocks it
        category: "weapons",
        icon: "long-cannon",
        barrel: (width: 0.2, length: 0.9, muzzle: 0.15),
        size: (1, 2),
        build_points: 5,
        control_cost: 2, // big machine, like the beam laser
        mass: 3.5,
        hp: 2,
        power: (draw: 3, tier: Low),
        heat: (output: 1.2, limit: 3.5),
        weapon: (family: Kinetic, damage: 1, range: 110, delivery: Projectile(rate: 0.6, speed: 220, penetration: 2, recoil: 3.5)),
        salvage: (family: "kinetic", data: 4),
        recipe: (materials: {"automaton_plate": 4, "copper": 2, "steel": 3}),
    ),
    // The ammo feeder (GDR-0018: the kinetic weapons' own support part): what the capacitor is to lasers, for guns
    // tagged `cannon`; a bigger step but at most two, and it cooks off when it is destroyed (the `ammo_feeder` node).
    (
        id: "ammo_feeder",
        name: "Ammo feeder",
        summary: "Feeds the cannons beside it so they fire faster. It takes no power from the pool.",
        description: "Each [[part:reverse_engineered_cannon|cannon]] counts at most two feeders. Its stored rounds go off when it is destroyed.",
        tags: ["feeder"],
        locked: true, // the utility research's `ammo_feeder` unlocks it
        category: "weapons",
        icon: "ammo-feeder",
        size: (1, 1),
        build_points: 2,
        mass: 1.5,
        hp: 1,
        heat: (output: 0.1, limit: 4),
        explosion: (damage: 0.8, radius: 0.6),
        salvage: (family: "utility", data: 2),
        recipe: (materials: {"copper": 1, "steel": 3}),
        bonuses: [
            (target: Tag("cannon"), stat: "fire_rate", effect: Percent(20), max_stacks: 2),
        ],
    ),
]
