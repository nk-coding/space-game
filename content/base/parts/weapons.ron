        barrel: (width: 0.25, length: 0.7, muzzle: 0.15), // as in the concept art
        size: (1, 2),
        build_points: 7,
        control_cost: 2, // big machine: lead placeholder (12 Oct 2026)
        mass: 4,
        hp: 2,
        power: (draw: 9, tier: Low, min_level: 0.5),
        heat: (output: 3.2, limit: 4.2),
        weapon: (family: Energy, damage: 2.6, range: 45, delivery: Beam),
        salvage: (family: "energy", data: 7),
        recipe: (materials: {"copper": 6, "crystal": 6, "steel": 2}),
    ),
    (
        id: "reverse_engineered_cannon",
        name: "Reverse-engineered cannon",
        summary: "A copy of the automatons' crude kinetic gun, built in your own shipyard.",
