// Power parts. PLACEHOLDER NUMBERS (concept-board drydock values, for feel only).
// `explosion`: the chain reaction when the part is destroyed (GDR-0019, GDR-0084, GDR-0085; PLACEHOLDER, lead
// defaults of 14 Oct 2026): `damage` once to every part, on any ship, with a cell within `radius` m of its centre;
// armour in between lets only its `blast_factor` through.
// `salvage`: what the part gives when salvaged and dismantled at home (research data about its build points;
// PLACEHOLDER, lead defaults of 13 Oct 2026 after docs/plans/first-playable-loop.md 3.2).
// `recipe`: what the workshop fabricates it from (GDR-0108; PLACEHOLDER amounts, about twice the build points);
// `needs` names the workshop upgrade it takes. Dismantling gives a share back (facilities.ron).
[
    (
        id: "fission_reactor",
        name: "Fission reactor",
        summary: "A compact reactor that feeds its piece's shared power pool.",
        description: "Each venting [[part:radiator]] beside it raises its output.",
        tags: ["reactor"],
        category: "power",
        icon: "fission-reactor",
        size: (1, 1),
        build_points: 4,
        mass: 4,
        hp: 1,
        power: (output: 10),
        heat: (output: 3, limit: 6),
        explosion: (damage: 1.5, radius: 1.5), // radius 1 → 1.5 (GDR-0085): two cells deep
        salvage: (family: "power", data: 4),
        recipe: (materials: {"ceramic": 3, "copper": 2, "steel": 3}),
    ),
    (
        id: "fusion_reactor",
        name: "Fusion reactor",
        summary: "A big reactor with plenty of power that runs hot.",
        locked: true, // mid-game: a new game starts without it, research unlocks it (Niklas, 13 Oct 2026, GDR-0063)
        description: "Like the [[part:fission_reactor]], it gains output from each venting [[part:radiator]] beside it.",
        tags: ["reactor"],
        category: "power",
        icon: "fusion-reactor",
        size: (2, 2),
        build_points: 10,
        control_cost: 2, // big machine: lead placeholder (12 Oct 2026)
        mass: 12,
        hp: 4,
        power: (output: 30),
        heat: (output: 6, limit: 8),
        explosion: (damage: 2.5, radius: 2), // radius 1.5 → 2 (GDR-0085): two cells deep
        salvage: (family: "power", data: 10),
        recipe: (materials: {"ceramic": 8, "coolant": 3, "copper": 6, "steel": 6}, needs: "fusion_workshop"), // coolant: the smelter's, from mined ice (GDR-0114)
    ),
    (
        id: "capacitor",
        name: "Capacitor",
        summary: "Makes the lasers beside it fire faster. It takes no power from the pool and holds none.",
        description: "Each laser counts at most three capacitors.",
        tags: ["capacitor"],
        category: "power",
        icon: "capacitor",
        size: (1, 1),
        build_points: 2,
        mass: 1,
        hp: 1,
        heat: (output: 0.15, limit: 4),
        explosion: (damage: 0.5, radius: 0.6),
        salvage: (family: "power", data: 2),
        recipe: (materials: {"ceramic": 1, "copper": 3}),
        bonuses: [
            (target: Tag("laser"), stat: "fire_rate", effect: Percent(15), max_stacks: 3),
        ],
    ),
    // The compact reactor (18 Oct 2026, GDR-0024's variant; the `compact_reactor` node): less power, but light,
    // cool and a small blast. PLACEHOLDER.
    (
        id: "compact_reactor",
        name: "Compact reactor",
        summary: "A light, cool reactor with less output and a small blast.",
        description: "About two thirds of a [[part:fission_reactor]]'s output for a little over half its heat and weight, and it goes off more gently. Each venting [[part:radiator]] beside it raises its output.",
        tags: ["reactor"],
        locked: true, // the power research's `compact_reactor` unlocks it
        category: "power",
        icon: "compact-reactor",
        size: (1, 1),
        build_points: 3,
        mass: 2.5,
        hp: 1,
        power: (output: 7),
        heat: (output: 1.6, limit: 6),
        explosion: (damage: 0.8, radius: 1),
        salvage: (family: "power", data: 3),
        recipe: (materials: {"ceramic": 2, "copper": 2, "steel": 2}),
    ),
]
