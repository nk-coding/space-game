// Parts of the Grown, the outer reach's living ships (GDR-0099, GDR-0102). PLACEHOLDER NUMBERS (lead defaults,
// 17 Oct 2026). Locked: a new game starts without them; the Grown research family (`research/grown.ron`, GDR-0103)
// unlocks all but the ganglion, which stays the Grown's own like the automaton plate. They use the enemy (coral)
// system colour, like the automatons' parts. `salvage`: data to the Grown family (18 Oct 2026, GDR-0103; was the
// rim's nearest families, logic, hull and kinetic).
// `recipe`: what the workshop fabricates it from (GDR-0108; PLACEHOLDER amounts, about twice the build points);
// `needs` names the workshop upgrade it takes. Dismantling gives a share back (facilities.ron).
[
    (
        id: "grown_heart",
        name: "Grown heart",
        summary: "A living heart: while it beats, the ship's lost blocks slowly grow back.",
        description: "One lost part every few seconds re-forms from its living neighbours, nearest to the heart first, and starts weak. Only parts of the ship's own design grow back, never a heart. It works on a vessel's controlling piece while it is alive and not overheated: kill the heart and the ship stays broken.",
        tags: ["grown", "heart"],
        locked: true,
        category: "defense",
        icon: "grown-heart",
        color: "enemy",
        size: (2, 2),
        build_points: 6,
        mass: 6,
        hp: 6,
        heat: (output: 0, limit: 4),
        // One part every 2.5 s, starting at 35% of its hit points (lead default, GDR-0102).
        heart: (interval: 2.5, hp: 0.35),
        salvage: (family: "grown", data: 6),
        recipe: (materials: {"grown_tissue": 10, "programmable_matter": 2}, needs: "grown_vat"),
    ),
    (
        id: "ram_prow",
        name: "Ram prow",
        summary: "A living prow of bone and tissue, built for ramming.",
        description: "When it is the part that touches in a ram, the other ship takes more of the ram damage and this side less. It heals slowly while it is on a vessel.",
        tags: ["grown", "ram"],
        locked: true,
        category: "weapons",
        icon: "ram-prow",
        color: "enemy",
        size: (2, 1),
        build_points: 4,
        mass: 5,
        hp: 6,
        heal: 0.1,
        ram: (dealt: 2, taken: 0.5),
        salvage: (family: "grown", data: 4),
        recipe: (materials: {"grown_tissue": 8, "steel": 2}, needs: "grown_vat"),
    ),
    (
        id: "thorn_gun",
        name: "Thorn gun",
        summary: "Throws a spray of kinetic spines at close range.",
        description: "Short reach and a quick rate of fire. Its spines are kinetic, so shield bubbles stop only half of their damage.",
        tags: ["grown"],
        locked: true,
        category: "weapons",
        icon: "thorn-gun",
        color: "enemy",
        size: (1, 1),
        build_points: 3,
        mass: 1.5,
        hp: 1.2,
        power: (draw: 1.5, tier: Low),
        heat: (output: 0.8, limit: 3),
        // 0.4 hit points a spine, 40 m (the cannon's 1 hit point at 75 m): strongest close in.
        weapon: (family: Kinetic, damage: 1.6, range: 40, delivery: Projectile(rate: 4, speed: 110, penetration: 1, recoil: 0.5)),
        salvage: (family: "grown", data: 3),
        recipe: (materials: {"grown_tissue": 5, "copper": 1}, needs: "grown_vat"),
    ),
    // The Grown's mind and power (GDR-0103, lead default 18 Oct 2026): what an automaton core is to a raider, a
    // knot of nerve tissue that thinks and feeds the ship. 8 MW runs two thorn guns and two thrusters (7 MW). It
    // gives no programmable matter (the Grown are not precursor work).
    (
        id: "grown_ganglion",
        name: "Grown ganglion",
        summary: "The knot of living nerves that thinks for a Grown ship and feeds it power.",
        description: "A Grown ship is a vessel while its ganglion lives. It runs a few rules, feeds the guns and engines, and heals slowly like the tissue round it. Salvaged, it gives research data, but no programmable matter: the Grown are not precursor work.",
        tags: ["grown", "core"],
        locked: true, // the Grown's own: no research unlocks it
        category: "logic",
        icon: "grown-ganglion",
        color: "enemy",
        size: (1, 1),
        build_points: 5,
        mass: 2.5,
        hp: 2.5,
        heal: 0.05,
        power: (output: 8),
        heat: (output: 1, limit: 4),
        logic: (rule_slots: 3, control_capacity: 6),
        sensor: (range: 800),
        gyro: (torque: 260),
        salvage: (family: "grown", data: 5),
        recipe: (materials: {"grown_tissue": 6, "programmable_matter": 2}, needs: "grown_vat"),
    ),
]
