// Parts of the Grown, the outer reach's living ships (GDR-0099, GDR-0102). PLACEHOLDER NUMBERS (lead defaults,
// 17 Oct 2026). Locked: a new game starts without them; `?unlock=all` puts them in the drydock until the Grown
// research family exists (phase 2 of the outer reach). They use the enemy (coral) system colour, like the
// automatons' parts. `salvage`: data to the nearest family of the rim's until that family exists.
[
    (
        id: "grown_heart",
        name: "Grown heart",
        summary: "A living heart: while it beats, the ship's lost blocks slowly grow back.",
        description: "One lost part every few seconds re-forms from its living neighbours, nearest to the heart first, and starts weak. Only parts of the ship's own design grow back, never a heart. It works on a vessel's controlling piece while it is alive and not overheated: kill the heart and the ship stays broken.",
        tags: ["grown", "heart"],
        locked: true,
        category: "defense",
        icon: "grown-heart",
        color: "enemy",
        size: (2, 2),
        build_points: 6,
        mass: 6,
        hp: 6,
        heat: (output: 0, limit: 4),
        // One part every 2.5 s, starting at 35% of its hit points (lead default, GDR-0102).
        heart: (interval: 2.5, hp: 0.35),
        salvage: (family: "logic", data: 6),
    ),
    (
        id: "ram_prow",
        name: "Ram prow",
        summary: "A living prow of bone and tissue, built for ramming.",
        description: "When it is the part that touches in a ram, the other ship takes more of the ram damage and this side less. It heals slowly while it is on a vessel.",
        tags: ["grown", "ram"],
        locked: true,
        category: "weapons",
        icon: "ram-prow",
        color: "enemy",
        size: (2, 1),
        build_points: 4,
        mass: 5,
        hp: 6,
        heal: 0.1,
        ram: (dealt: 2, taken: 0.5),
        salvage: (family: "hull", data: 4),
    ),
    (
        id: "thorn_gun",
        name: "Thorn gun",
        summary: "Throws a spray of kinetic spines at close range.",
        description: "Short reach and a quick rate of fire. Its spines are kinetic, so shield bubbles stop only half of their damage.",
        tags: ["grown"],
        locked: true,
        category: "weapons",
        icon: "thorn-gun",
        color: "enemy",
        size: (1, 1),
        build_points: 3,
        mass: 1.5,
        hp: 1.2,
        power: (draw: 1.5, tier: Low),
        heat: (output: 0.8, limit: 3),
        // 0.4 hit points a spine, 40 m (the cannon's 1 hit point at 75 m): strongest close in.
        weapon: (family: Kinetic, damage: 1.6, range: 40, delivery: Projectile(rate: 4, speed: 110, penetration: 1, recoil: 0.5)),
        salvage: (family: "kinetic", data: 3),
    ),
]
