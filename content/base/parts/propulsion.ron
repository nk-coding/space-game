// Propulsion. PLACEHOLDER NUMBERS: thrust from the concept-board drydock; gimbal, gyro and RCS values are invented, all for feel only.
// Engines push towards the part's forward side and need open cells directly behind them; `gimbal` swings their
// thrust a few degrees to either side. Gyros turn the ship without thrust; RCS pods fire a nozzle out of every
// side that is open to space.
// Power tier: everything that moves the ship is `Normal` (the default), so thrust and turning brown out together.
[
    (
        id: "thruster",
        name: "Thruster",
        summary: "A small engine that needs open space behind it.",
        tags: ["engine"],
        category: "propulsion",
        icon: "thruster",
        size: (1, 1),
        build_points: 3,
        mass: 2,
        hp: 1,
        power: (draw: 2),
        heat: (output: 0.8, limit: 3.2),
        engine: (thrust: 12, gimbal: 5),
