// The rim's kinds of cluster (GDR-0094). A cluster's interior is rolled from its seed when the fleet warps in: a
// radius (metres, at most 4 km: one f32 space, ADR-0022), its ordinary sites from `sites` (counts `(min, max)`),
// spaced as a voyage's, plus the trail places the galaxy put there. `words` give the second word of the name.
// PLACEHOLDER NUMBERS (lead, 16 Oct 2026, GDR-0094; the slice's voyages are 0.6-1 km with 3-5 sites, these are
// 2-3 km for searching, GDR-0080; a wreck drift's gunner pair 17 Oct 2026, GDR-0101;
// a picket post in the wreck drifts and hunting reaches 18 Oct 2026, GDR-0111).
[
    (
        id: "wreck_drift",
        name: "Wreck drift",
        summary: "A drift of old hulls and the raiders that pick them over.",
        radius: (2000, 2600),
        spacing: (500, 1200),
        words: ["Drift", "Shoal"],
        sites: [
            (encounter: "raider_pair", count: (1, 3)),
            (encounter: "gunner_pair", count: (0, 1)),
            (encounter: "derelict_field", count: (1, 2)),
            (encounter: "precursor_wrecks", count: (0, 1)),
            (encounter: "raider_den", count: (0, 1)),
            (encounter: "precursor_outpost", count: (0, 1)),
            (encounter: "picket_post", count: (0, 1)),
        ],
        scenery: (
            rocks: [
                (rock: "iron_rock", layout: Field(radius: 220), count: (1, 2), rocks: (14, 22)),
                (rock: "iron_rock", layout: Scatter, count: (1, 1), rocks: (30, 45)),
            ],
            dust: 1.2,
            debris: 1.6,
            derelicts: (3, 6),
            landmarks: [(landmark: "derelict_station", chance: 0.5), (landmark: "junk_ring", chance: 0.3)],
        ),
    ),
    (
        id: "hunting_reach",
        name: "Hunting reach",
        summary: "Long, open space where heavier automatons hunt in packs.",
        radius: (2200, 3000),
        spacing: (600, 1400),
        words: ["Reach", "Run"],
        sites: [
            (encounter: "hunter_pack", count: (1, 2)),
            (encounter: "raider_pack", count: (0, 2)),
            (encounter: "precursor_wrecks", count: (0, 1)),
            (encounter: "hunter_den", count: (0, 1)),
            (encounter: "picket_post", count: (0, 1)),
        ],
        scenery: (
            rocks: [
                (rock: "iron_rock", layout: Belt(width: 180), count: (1, 1), rocks: (40, 60)),
                (rock: "ice_rock", layout: Scatter, count: (1, 1), rocks: (20, 30)),
            ],
            dust: 0.8,
            debris: 0.8,
            derelicts: (1, 3),
            landmarks: [(landmark: "silent_beacon", chance: 0.5)],
        ),
    ),
    (
        id: "quiet_field",
        name: "Quiet field",
        summary: "A still field of wreckage with little left to guard it.",
        radius: (1800, 2400),
        spacing: (500, 1100),
        words: ["Field", "Hollow"],
        sites: [
            (encounter: "derelict_field", count: (1, 2)),
            (encounter: "precursor_wrecks", count: (1, 2)),
            (encounter: "core_graveyard", count: (0, 1)),
            (encounter: "raider_pair", count: (0, 1)),
        ],
        scenery: (
            rocks: [
                (rock: "ice_rock", layout: Field(radius: 200), count: (2, 3), rocks: (12, 20)),
                (rock: "iron_rock", layout: Scatter, count: (1, 1), rocks: (20, 30)),
            ],
            dust: 1.0,
            debris: 1.2,
            derelicts: (2, 5),
            landmarks: [(landmark: "junk_ring", chance: 0.5), (landmark: "derelict_station", chance: 0.3)],
        ),
    ),
]
