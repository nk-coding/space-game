// The outer reach's hot clusters (GDR-0099 A5, GDR-0102): a hot star lies beside the cluster, and every part open to
// space takes its heat, more near the star. The Grown keep groves here too (18 Oct 2026, GDR-0103; the rim's
// automatons stood in until then), and their hearts overheat on the star's side like any part. PLACEHOLDER NUMBERS (lead, 17 Oct 2026, GDR-0102): the star lies 1.8 radii out, so a
// part takes 0.3 heat a second per open side at the centre, about 1.5 at the cluster's edge nearest the star and 0.12
// at the far edge; a shield emitter open on two sides runs at two thirds of its limit at the centre and overheats
// on the star's side unless a radiator beside it vents the heat (`sim/tests/living.rs`).
(
    id: "scorched_deep",
    name: "Scorched deep",
    summary: "Space beside a hot star, with Grown groves: every part open to space soaks up its heat, the more the nearer you fly to it.",
    tags: ["hot"],
    radius: (2000, 2800),
    spacing: (600, 1400),
    words: ["Glare", "Furnace"],
    sites: [
        (encounter: "grove", count: (1, 2)),
        (encounter: "grove_pair", count: (0, 1)),
        (encounter: "grown_dead", count: (0, 1)),
        (encounter: "precursor_wrecks", count: (0, 1)),
    ],
    star: (heat: 0.3, distance: 1.8),
    scenery: (
        rocks: [
            (rock: "slag_rock", layout: Field(radius: 200), count: (1, 2), rocks: (12, 20)),
            (rock: "slag_rock", layout: Scatter, count: (1, 1), rocks: (10, 16)),
        ],
        dust: 1.5,
        debris: 0.6,
        derelicts: (0, 2),
        landmarks: [(landmark: "star_corona", chance: 1.0)],
        fights: 0.2,
    ),
)
