// What waits in the middle band (GDR-0027: the Swarm, hostile by nature; GDR-0117): spitter patrols, hive carriers
// that flood the space round them with drones, the Swarm's own dead, their raids on the Grown past the band's border,
// and the hives, their bosses, at the end of trails of their own. The Swarm are not wary: they wake when a ship
// comes near. PLACEHOLDER NUMBERS (lead defaults, 19 Oct 2026; counts tuned with the headless voyage runner,
// docs/results/swarm-balance-2026-10-19.md).
[
    (
        id: "swarm_patrol",
        name: "Spitter patrol",
        summary: "Three to five Swarm spitters on patrol, quick to close in.",
        tags: ["swarm"],
        ships: [(ship: "swarm_spitter", count: (3, 5))], // 3-4 and a wake radius of 300 until 19 Oct 2026 (later)
        wake_radius: 220,
    ),
    (
        id: "hive_carrier",
        name: "Hive carrier",
        summary: "A Swarm carrier alone: it floods the space round it with drones the moment it sees you.",
        description: "The [[ship:swarm_carrier]] holds back while its twelve [[ship:swarm_drone|drones]] fight. Drones die with their hangar: dive through the flood for a flank, or thin the flood and wait for the rebuild.",
        tags: ["swarm", "carrier"],
        ships: [
            (ship: "swarm_carrier", count: (1, 1)), // a spitter (0-1) at its side until 19 Oct 2026 (later)
        ],
        wake_radius: 350,
    ),
    (
        id: "brood_nest",
        name: "Brood nest",
        summary: "A hive carrier at rest among its spitters' wrecks: rich Swarm salvage, if the flood can be beaten.",
        tags: ["swarm", "carrier", "wrecks"],
        ships: [(ship: "swarm_carrier", count: (1, 1))],
        wrecks: [(ship: "swarm_spitter", count: (1, 2), damage: 0.4)],
        wake_radius: 350,
    ),
    (
        id: "swarm_dead",
        name: "Swarm dead",
        summary: "Swarm wrecks drifting alone, their nerve nodes long still.",
        tags: ["swarm", "wrecks"],
        wrecks: [
            (ship: "swarm_spitter", count: (1, 2), damage: 0.3),
            (ship: "swarm_carrier", count: (0, 1), damage: 0.4),
        ],
        wake_radius: 200,
    ),
    (
        id: "swarm_raid",
        name: "Swarm raid",
        summary: "Spitters picking over a grove they raided past the border: the Grown's dead lie round them.",
        description: "The Swarm are the one race that raids its neighbours (GDR-0027). What they left of the grove is still rich in Grown salvage.",
        lore: "The groves nearest the middle band are all scarred on the same side.",
        tags: ["swarm", "wrecks"],
        ships: [(ship: "swarm_spitter", count: (3, 4))], // 2 until 19 Oct 2026
        wrecks: [(ship: "grown_rammer", count: (1, 2), damage: 0.5)],
        wake_radius: 300,
    ),
    (
        id: "hive_site",
        name: "Swarm hive",
        summary: "One of the Swarm's hives, anchored deep in the middle band: it needs no guard but its own flood.",
        description: "The [[ship:swarm_hive]] cannot chase you, but its four hangars send twenty-four drones at whatever it sees. Take the hangars one by one: every drone dies with its own. Beaten, it is the richest Swarm salvage there is.",
        lore: "You hear it before you see it.",
        tags: ["boss", "swarm", "station"],
        ships: [
            (ship: "swarm_hive", count: (1, 1)),
        ],
        wake_radius: 400,
    ),
    // The middle band's cache and graveyard (GDR-0128, lead defaults 20 Oct 2026): a cache the Swarm buried in resin and
    // a battlefield they are picking clean. Not wary: both wake when a ship comes near.
    (
        id: "resin_cache",
        name: "Resin-sealed cache",
        summary: "A sealed precursor cache the Swarm have buried in resin, three or four spitters circling it.",
        description: "The spitters wake as soon as a ship comes near. Beat them and the cache's seals answer you through the resin: what it holds goes straight into store, and the hulls round it are rich salvage.",
        lore: "The Swarm could not open it, so they buried it. They were still guarding it when you came.",
        tags: ["cache", "swarm", "wrecks"],
        ships: [(ship: "swarm_spitter", count: (3, 4))],
        wrecks: [
            (ship: "sample_mid", count: (2, 2), damage: 0.3),
            (ship: "swarm_spitter", count: (1, 2), damage: 0.4),
        ],
        wake_radius: 260,
    ),
    (
        id: "picked_graveyard",
        name: "Picked graveyard",
        summary: "An old battlefield of precursor hulls and automatons that Swarm spitters are picking clean.",
        description: "Far more to salvage than an ordinary graveyard: precursor hulls, automatons, and the spitters' own dead. The spitters picking at it wake together.",
        lore: "Whatever fought here, the Swarm came afterwards. They always do.",
        tags: ["swarm", "wrecks", "cores"],
        ships: [(ship: "swarm_spitter", count: (2, 3))],
        wrecks: [
            (ship: "sample_mid", count: (1, 2), damage: 0.3),
            (ship: "automaton_hunter", count: (2, 3), damage: 0.35),
            (ship: "automaton_raider", count: (3, 5), damage: 0.3),
            (ship: "swarm_spitter", count: (2, 3), damage: 0.3),
        ],
        wake_radius: 300,
    ),
    // A patrol with a scout (GDR-0128, after GDR-0111 and GDR-0113; lead defaults 20 Oct 2026). PLACEHOLDER counts
    // (docs/results/deeper-bands-2026-10-20.md).
    (
        id: "scout_patrol",
        name: "Scout patrol",
        summary: "Two or three spitters with a scout, an unarmed Swarm ship that runs and calls the brood.",
        description: "When the patrol wakes, the [[ship:swarm_scout]] runs, and once clear of your guns its scan wakes every Swarm site within the scanner's range, and its first scan calls a [[encounter:swarm_call|spitter]] in from the cluster's edge. Shoot it first, or keep on its tail.",
        lore: "The spitters fight. The scout only watches, and tells.",
        tags: ["swarm", "picket"],
        ships: [
            (ship: "swarm_scout", count: (1, 1)),
            (ship: "swarm_spitter", count: (2, 3)),
        ],
        wake_radius: 220,
        calls: "swarm_call",
    ),
    (
        // Never placed in a cluster; it warps in on the edge `sim::CALL_SECONDS` after a scout patrol's first call.
        id: "swarm_call",
        name: "Answering spitter",
        summary: "A Swarm spitter a scout called: it comes in at the cluster's edge and heads where the scout saw you.",
        description: "When a [[encounter:scout_patrol]]'s [[ship:swarm_scout]] gets its first scan off, a spitter comes in at the cluster's edge half a minute later and flies to where the scout saw you. Its wreck is salvage like any other.",
        tags: ["swarm", "called"],
        ships: [(ship: "swarm_spitter", count: (1, 1))], // 2-3 until 20 Oct 2026 (a call cost 22-26 points; 1-2: 15-19)
        wake_radius: 220,
    ),
]
