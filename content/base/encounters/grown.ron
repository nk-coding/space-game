    (
        id: "seedling_shoal",
        name: "Seedling shoal",
        summary: "Five or six of the Grown's smallest, drifting in a shoal: calm until provoked, then they charge from every side.",
        description: "Each [[ship:grown_seedling]] breaks quickly but heals if you leave it: turn fast, and finish one before the next.",
        lore: "They wheel round together like fish, and scatter the same way.",
        tags: ["grown", "swarm"],
        ships: [(ship: "grown_seedling", count: (5, 6))],
        wake_radius: 250,
    ),
    (
        id: "scorched_wrecks",
        name: "Sun-scorched wrecks",
        summary: "Precursor hulls parked as close to the hot star as the cluster goes, unguarded and rich.",
        description: "Nothing guards them: the star does. Every part open to space soaks up its heat, several times what it takes at the cluster's centre, so strip what you can and leave before your parts cook.",
        lore: "Whoever parked them here wanted them left alone. The star has kept them that way.",
