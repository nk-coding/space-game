    // A grove with a lookout (GDR-0128, after GDR-0111 and GDR-0113; lead defaults 20 Oct 2026): calm until provoked,
    // then its sentinel runs and calls. PLACEHOLDER counts (docs/results/deeper-bands-2026-10-20.md).
    (
        id: "watched_grove",
        name: "Watched grove",
        summary: "A rammer and a thornback at rest with a sentinel, an unarmed lookout that runs and calls the groves.",
        description: "Provoke the grove and the [[ship:grown_sentinel]] runs; once clear of your guns its scan wakes every Grown site within the scanner's range, and its first scan calls a [[encounter:grove_call|rammer]] in from the cluster's edge. Shoot it first, or keep on its tail.",
        lore: "One of every grove keeps its eyes open.",
        tags: ["grown", "picket"],
        ships: [
            (ship: "grown_sentinel", count: (1, 1)),
            (ship: "grown_rammer", count: (1, 1)),
            (ship: "grown_thornback", count: (1, 1)),
        ],
        wake_radius: 250,
        calls: "grove_call",
    ),
    (
        // Never placed in a cluster; it comes in on the edge `sim::CALL_SECONDS` after a watched grove's first call.
        id: "grove_call",
        name: "Answering rammer",
        summary: "A Grown rammer a sentinel called: it comes in at the cluster's edge and heads where the sentinel saw you.",
        description: "When a [[encounter:watched_grove]]'s [[ship:grown_sentinel]] gets its first scan off, a rammer comes in at the cluster's edge half a minute later and flies to where the sentinel saw you. Its wreck is salvage like any other.",
        tags: ["grown", "called"],
        ships: [(ship: "grown_rammer", count: (1, 1))], // a thornback beside it until 20 Oct 2026 (a call cost 22-28 points)
