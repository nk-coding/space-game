        ships: [
            (ship: "grown_guardian", count: (1, 1)),
            (ship: "grown_rammer", count: (1, 1)),
        ],
        wrecks: [(ship: "grown_thornback", count: (1, 1), damage: 0.4)],
        wake_radius: 300,
    ),
    (
        id: "grown_dead",
