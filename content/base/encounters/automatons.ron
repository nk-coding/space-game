    (
        id: "sealed_cache",
        name: "Sealed cache",
        summary: "A precursor cache still sealed, its automaton keepers on watch round it.",
        description: "Beat its keepers and the cache opens: what it holds goes straight into store, and the hulls around it are rich salvage.",
        lore: "The seals answer to a mind like yours. They open as if they had been waiting.",
        tags: ["cache", "wrecks"],
        ships: [
            (ship: "automaton_hunter", count: (1, 1)),
