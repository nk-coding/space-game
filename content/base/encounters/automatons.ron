        wake_radius: 300,
    ),
    (
        id: "memory_wreck",
        name: "Memory wreck",
        summary: "A precursor hull adrift on its own, its log still whole.",
        description: "Nothing guards it. Its log goes into the memory log as soon as a ship sees it.",
        lore: "Its core is cold, but the log in it was written to be found.",
        tags: ["lore", "wrecks"],
        wrecks: [(ship: "sample_mid", count: (1, 1), damage: 0.2)],
        wake_radius: 200,
    ),
    (
        id: "deep_graveyard",
        name: "Deep graveyard",
        summary: "Row after row of burned-out automatons, a raider pack keeping it.",
        description: "Far more to salvage than an ordinary graveyard, and the raiders that keep it wake together.",
        lore: "The rows go on further than the scanner reaches. Someone has been bringing them here for a long time.",
        tags: ["wrecks", "cores"],
        ships: [(ship: "automaton_raider", count: (2, 3))],
        wrecks: [
