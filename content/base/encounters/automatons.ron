// What waits at a voyage site (GDR-0062). Ships hold until a player vessel comes within `wake_radius` (metres of the
// site), then fly their faction's behavior; wrecks spawn as salvage with `damage` (a share of their parts) already
// gone, rolled on the sim's encounter stream. Counts are `(min, max)`, both included, rolled per launch. The
// variants by count (a pair, a pack, a den) are entries of their own. PLACEHOLDER NUMBERS (track 7J
// draft of 13 Oct 2026; counts tuned with the headless voyage runner the same day, GDR-0073 and
// docs/results/slice-balance-2026-10-13.md: no single ship of the slice wins against three raiders at once often).
[
    (
        id: "raider_pair",
        name: "Raider pair",
        summary: "Two raiders picking over the wreckage, waking when a ship comes near.",
        tags: ["raiders"],
        ships: [(ship: "automaton_raider", count: (2, 2))],
        wake_radius: 250,
    ),
    (
        id: "raider_pack",
        name: "Raider pack",
        summary: "A few raiders drifting among the rocks, waking when a ship comes near.",
        tags: ["raiders"],
        ships: [(ship: "automaton_raider", count: (3, 3))],
        wake_radius: 250,
    ),
    (
        id: "raider_den",
        name: "Raider den",
        summary: "Where the raiders gather: a pack that wakes all at once, and from farther off.",
        tags: ["raiders"],
        ships: [(ship: "automaton_raider", count: (2, 3))],
        wake_radius: 300,
    ),
    (
        id: "hunter_pack",
        name: "Hunter pack",
        summary: "A heavier automaton with a cannon on each prong, and a raider running ahead of it.",
        tags: ["hunters"],
        ships: [
            (ship: "automaton_hunter", count: (1, 1)),
            (ship: "automaton_raider", count: (1, 1)),
        ],
        wake_radius: 250,
    ),
    (
        id: "hunter_den",
        name: "Hunter den",
        summary: "The hunters' lair: two or three of them, waking together.",
        tags: ["hunters"],
        ships: [(ship: "automaton_hunter", count: (2, 3))],
        wake_radius: 300,
    ),
    (
        id: "derelict_field",
        name: "Derelict field",
        summary: "Old shipyard hulls, long dead, among wrecked raiders; sometimes a live one is still picking at them.",
        lore: "Hulls from the shipyard's last launch. Not one of them got past the rim.",
        tags: ["wrecks"],
        ships: [(ship: "automaton_raider", count: (0, 1))],
        wrecks: [
            (ship: "sample_early", count: (1, 1), damage: 0.5),
            (ship: "automaton_raider", count: (2, 3), damage: 0.5),
        ],
        wake_radius: 200,
    ),
    (
        id: "precursor_wrecks",
        name: "Precursor wrecks",
        summary: "Old hulls full of parts the shipyard has forgotten how to make.",
        lore: "Their logs stop mid-sentence, all on the same day.",
        tags: ["wrecks"],
        ships: [(ship: "automaton_raider", count: (0, 1))],
        wrecks: [(ship: "sample_mid", count: (1, 2), damage: 0.4)],
        wake_radius: 200,
    ),
    (
        id: "core_graveyard",
        name: "Core graveyard",
        summary: "Burned-out raiders lying in rows, many of their cores still whole.",
        lore: "Raiders drag their burned-out kin here and leave them in rows. Nobody taught them to.",
        tags: ["wrecks", "cores"],
        ships: [(ship: "automaton_raider", count: (0, 1))],
        wrecks: [(ship: "automaton_raider", count: (4, 6), damage: 0.3)],
        wake_radius: 200,
    ),
    (
        id: "sealed_cache",
        name: "Sealed cache",
        summary: "A precursor cache still sealed, its automaton keepers on watch round it.",
        description: "Beat its keepers and the cache opens: what it holds goes straight into store, and the hulls around it are rich salvage.",
        lore: "The seals answer to a mind like yours. They open as if they had been waiting.",
        tags: ["cache", "wrecks"],
        ships: [
            (ship: "automaton_hunter", count: (1, 1)),
            (ship: "automaton_raider", count: (1, 2)),
        ],
        wrecks: [(ship: "sample_mid", count: (2, 3), damage: 0.2)],
        wake_radius: 300,
    ),
    (
        id: "memory_wreck",
        name: "Memory wreck",
        summary: "A precursor hull adrift on its own, its log still whole.",
        description: "Nothing guards it. Its log goes into the memory log as soon as a ship sees it.",
        lore: "Its core is cold, but the log in it was written to be found.",
        tags: ["lore", "wrecks"],
        wrecks: [(ship: "sample_mid", count: (1, 1), damage: 0.2)],
        wake_radius: 200,
    ),
    (
        id: "deep_graveyard",
        name: "Deep graveyard",
        summary: "Row after row of burned-out automatons, a raider pack keeping it.",
        description: "Far more to salvage than an ordinary graveyard, and the raiders that keep it wake together.",
        lore: "The rows go on further than the scanner reaches. Someone has been bringing them here for a long time.",
        tags: ["wrecks", "cores"],
        ships: [(ship: "automaton_raider", count: (2, 3))],
        wrecks: [
            (ship: "automaton_raider", count: (7, 10), damage: 0.25),
            (ship: "automaton_hunter", count: (1, 2), damage: 0.4),
        ],
        wake_radius: 300,
    ),
    (
        id: "gate_sentinel",
        name: "Gate sentinel",
        summary: "Another of the Warden's kind, keeping another of the rim's gates, with a hunter at its side.",
        description: "Built like the [[ship:automaton_warden]] and fought the same way: each fist flies on alone once it is shot off. Beaten, its gate opens.",
        lore: "Every gate had one. Not one of them has moved since the last launch.",
        tags: ["boss"],
        ships: [
            (ship: "automaton_warden", count: (1, 1)),
            (ship: "automaton_hunter", count: (1, 1)),
        ],
        wake_radius: 300,
    ),
    (
        id: "the_warden",
        name: "The Warden",
        summary: "The gate's old guardian, with raiders at its side.",
        description: "Shoot the [[ship:automaton_warden]] apart and it fights on in pieces: each fist flies on alone, and the shielded heart holds until its core goes dark or its cannon is shot off.",
        lore: "Nobody ever told it that its makers are not coming back.",
        tags: ["boss"],
        ships: [
            (ship: "automaton_warden", count: (1, 1)),
            (ship: "automaton_raider", count: (1, 2)),
        ],
        wake_radius: 300,
    ),
]
