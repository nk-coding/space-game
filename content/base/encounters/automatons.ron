        description: "Built like the [[ship:automaton_warden]] and fought the same way: each fist flies on alone once it is shot off. Beaten, its gate opens.",
        lore: "Every gate had one. Not one of them has moved since the last launch.",
        tags: ["boss"],
        ships: [
            (ship: "automaton_warden", count: (1, 1)),
            (ship: "automaton_hunter", count: (1, 1)),
        ],
