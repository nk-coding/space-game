// Trail templates (GDR-0078, GDR-0094): a chain of `length` signals `(min, max)` ending at a reward. The first
// signal's source lies in an ordinary cluster, each later one at the place the signal before it led to; the last
// place holds `target`. `sources` are equally likely per signal; `hint` is the signal's first line on the map
// ("SIGNAL · SOMETHING OLD"). Bands place gate trails (`gates`), caches and graveyards (`trails`); lore fragments
// place their own. Following a trail to its end gives its reward (GDR-0098): a gate opens, a fragment joins the
// memory log, `gives` goes into store (a cache's research data and materials), a graveyard is salvage.
// PLACEHOLDER NUMBERS (lead, 16 Oct 2026, from the plan's section 4.3; the rewards and targets 17 Oct 2026, track E8;
// the outer reach's gates and elder groves 18 Oct 2026, GDR-0103; the deeper gates' Keeper the same day, GDR-0112;
// the inner band's Spire 19 Oct 2026, GDR-0116).
[
    (
        id: "rim_gate",
        name: "A rim gate",
        summary: "The long trail to one of the rim's gates, and the old guardian that keeps it.",
        reward: Gate,
        length: (3, 4),
        target: "gate_sentinel",
        sources: ["hauler_log", "precursor_log", "old_beacon"],
        hint: "A gate",
        gives: (materials: {"gate_shard": 1}), // the guardian's gate shard (GDR-0031, 18 Oct 2026)
    ),
    (
        id: "deep_gate",
        name: "A deeper gate",
        summary: "The long trail to a gate further in, and the Keeper that guards it.",
        reward: Gate,
        length: (3, 4),
        target: "keeper_gate", // the Keeper (GDR-0112, 18 Oct 2026)
        sources: ["hauler_log", "precursor_log", "old_beacon"],
        hint: "A gate",
        gives: (materials: {"gate_shard": 1}), // the guardian's gate shard (GDR-0031, 18 Oct 2026)
    ),
    (
        id: "inner_gate",
        name: "An inner gate",
        summary: "The long trail to one of the inner band's gates, and the crystal-warded Spire that keeps it.",
        reward: Gate,
        length: (3, 4),
        target: "spire_gate", // the Spire (GDR-0116, 19 Oct 2026)
        sources: ["hauler_log", "precursor_log", "old_beacon"],
        hint: "A gate",
        gives: (materials: {"gate_shard": 2}), // the last guardian before the core gives two (GDR-0116)
    ),
    (
        id: "outer_gate",
        name: "An outer gate",
        summary: "The long trail to one of the outer reach's gates, and the precursor guardian that keeps it.",
        reward: Gate,
        length: (3, 4),
        target: "bastion_gate",
        sources: ["hauler_log", "precursor_log", "old_beacon"],
        hint: "A gate",
        gives: (materials: {"gate_shard": 1}), // the guardian's gate shard (GDR-0031, 18 Oct 2026)
    ),
    (
        id: "elder_grove",
        name: "An elder grove",
        summary: "A trail to one of the Grown's giants, at rest in a grove of its own: rich salvage, if it can be beaten.",
        reward: Salvage,
        length: (2, 3),
        target: "elder_grove",
        sources: ["distress_call", "old_beacon"],
        hint: "Something vast",
        gives: (materials: {"heartwood": 3}), // an elder's heartwood (18 Oct 2026, materials/grown.ron)
    ),
    (
        id: "swarm_hive",
        name: "A Swarm hive",
        summary: "A trail to one of the Swarm's hives, anchored deep in the middle band: rich salvage, if the flood can be beaten.",
        reward: Salvage,
        length: (2, 3),
        target: "hive_site",
        sources: ["distress_call", "old_beacon"],
        hint: "A hum",
        gives: (materials: {"nerve_core": 3, "resin": 6}), // the hive's brood stores (19 Oct 2026, GDR-0117)
    ),
    (
        id: "lattice_resonator",
        name: "A Lattice resonator",
        summary: "A trail to one of the Lattice's resonators, anchored deep in the inner band: rich salvage, if its lance can be beaten.",
        reward: Salvage,
        length: (2, 3),
        target: "resonator_site",
        sources: ["distress_call", "old_beacon"],
        hint: "A clear note",
        // Only in the Lattice's own clusters (GDR-0126, GDR-0127: one faction per cluster in the inner band).
        ends_in: ["lattice_reach", "crystal_deep"],
        gives: (materials: {"resonant_crystal": 3, "crystal": 6}), // the resonator's crystal (20 Oct 2026, GDR-0126)
    ),
    (
        id: "phase_colossus",
        name: "A phase colossus",
        summary: "A trail to one of the Phase walkers' giant phase ships, resting in one of their rifts in the inner band.",
        reward: Salvage,
        length: (2, 3),
        target: "colossus_site",
        sources: ["distress_call", "old_beacon"],
        hint: "A double echo",
        // Only in the walkers' own clusters (GDR-0127: one faction per cluster).
        ends_in: ["phase_rift"],
        gives: (materials: {"phase_residue": 3, "rift_silt": 4}), // the colossus's drives and cores (20 Oct 2026, GDR-0127)
    ),
    (
        id: "precursor_cache",
        name: "A precursor cache",
        summary: "A sealed cache of precursor work: research data and programmable matter, straight into store.",
        reward: Cache,
        length: (2, 3),
        target: "sealed_cache",
        sources: ["precursor_log", "old_beacon"],
        hint: "A cache",
        gives: (data: {"logic": 8, "propulsion": 8}, materials: {"programmable_matter": 4}),
    ),
    (
        id: "memory",
        name: "A memory",
        summary: "A short trail to a fragment of what happened, for the memory log.",
        reward: Lore,
        length: (1, 2),
        target: "memory_wreck",
        sources: ["precursor_log", "old_beacon", "distress_call"],
        hint: "Something old",
    ),
    (
        id: "graveyard",
        name: "A graveyard",
        summary: "A short trail to a graveyard with far more to salvage than usual.",
        reward: Salvage,
        length: (1, 2),
        target: "deep_graveyard",
        sources: ["hauler_log", "distress_call"],
        hint: "A graveyard",
    ),
]
