// Trail templates (GDR-0078, GDR-0094): a chain of `length` signals `(min, max)` ending at a reward. The first
// signal's source lies in an ordinary cluster, each later one at the place the signal before it led to; the last
// place holds `target`. `sources` are equally likely per signal; `hint` is the signal's first line on the map
// ("SIGNAL · SOMETHING OLD"). Bands place gate trails (`gates`), caches and graveyards (`trails`); lore fragments
// place their own. PLACEHOLDER NUMBERS (lead, 16 Oct 2026, from the plan's section 4.3). The targets are the slice's
// encounters until track E8 gives caches and lore wrecks their own (a new encounter changes the rules' fingerprint,
// which marks saved lab runs stale, GDR-0092).
[
    (
        id: "rim_gate",
        name: "A rim gate",
        summary: "The long trail to one of the rim's gates, and the old guardian that keeps it.",
        reward: Gate,
        length: (3, 4),
        target: "the_warden",
        sources: ["hauler_log", "precursor_log", "old_beacon"],
        hint: "A gate",
    ),
    (
        id: "deep_gate",
        name: "A deeper gate",
        summary: "A trail to a gate further in. Its guardian is a stand-in until the band has its own.",
        tags: ["stub"],
        reward: Gate,
        length: (3, 4),
        target: "the_warden",
        sources: ["hauler_log", "precursor_log", "old_beacon"],
        hint: "A gate",
    ),
    (
        id: "precursor_cache",
        name: "A precursor cache",
        summary: "A sealed cache of precursor work: a research node or a part found nowhere else.",
        reward: Cache,
        length: (2, 3),
        target: "precursor_wrecks",
        sources: ["precursor_log", "old_beacon"],
        hint: "A cache",
    ),
    (
        id: "memory",
        name: "A memory",
        summary: "A short trail to a fragment of what happened, for the memory log.",
        reward: Lore,
        length: (1, 2),
        target: "precursor_wrecks",
        sources: ["precursor_log", "old_beacon", "distress_call"],
        hint: "Something old",
    ),
    (
        id: "graveyard",
        name: "A graveyard",
        summary: "A short trail to a graveyard with far more to salvage than usual.",
        reward: Salvage,
        length: (1, 2),
        target: "core_graveyard",
        sources: ["hauler_log", "distress_call"],
        hint: "A graveyard",
    ),
]
